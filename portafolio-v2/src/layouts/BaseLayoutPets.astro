---
import NavParabolic from '../components/NavParabolic.astro';
import Footer from '../components/Footer.astro';
---
<html lang="es">
  <head>
    <!-- Favicon ELOA -->
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Creepster&family=Mulish:wght@300;400;600;700&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>ELOA Parabolic Pets</title>
  </head>
  <body>
    <NavParabolic />

    <!-- contenido de cada proyecto -->
    <main>
        <slot /> 
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  html {
    overflow-x: hidden;
    width: 100%;
    overscroll-behavior-x: none;
  }

  body {
    overflow-x: hidden;
    width: 100%;
    max-width: 100vw;
    margin: 0;
    position: relative;
    overscroll-behavior-x: none;
    touch-action: pan-y;
  }

  main {
  padding-top: 100px; 
}

@media (max-width: 699px) {
  main {
    padding-top: 100px; 
  }
}

  * {
    box-sizing: border-box;
  }
</style>