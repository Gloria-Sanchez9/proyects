---
import NavProtocol from '../components/NavProtocol.astro';
import Footer from '../components/Footer.astro';

const { title = 'Protocol Entropy | ELOA' } = Astro.props;
---
<html lang="es">
  <head>
    <!-- Favicon ELOA -->
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Mulish:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <NavProtocol />

    <main>
        <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  html {
    overflow-x: hidden;
    width: 100%;
    overscroll-behavior-x: none;
    scroll-behavior: smooth;
    scroll-padding-top: 80px; /* que el nav fijo no tape los títulos al usar #sobre */
  }

  body {
    overflow-x: hidden;
    width: 100%;
    max-width: 100vw;
    margin: 0;
    position: relative;
    overscroll-behavior-x: none;
    background: #050304;
    color: #f2e9ea;
  }

  * {
    box-sizing: border-box;
  }
</style>
