---
import BaseLayoutWeavy from '../../layouts/BaseLayoutWeavy.astro';
---

<BaseLayoutWeavy>

    <section id="escena-inicio" data-scene>
        <header class="header-con-ola">
            <img src="/proyects/imagenes/weavy/titulo1.png" alt="Weavy" class="imagen-flotante">

            <div class="decoracion-header" aria-hidden="true">
                <img src="/proyects/imagenes/weavy/caballito.png" class="deco-h deco-h1" alt="">
                <img src="/proyects/imagenes/weavy/tortuga.png" class="deco-h deco-h2" alt="">
                <img src="/proyects/imagenes/weavy/camaron.png" class="deco-h deco-h3" alt="">
                <img src="/proyects/imagenes/weavy/cangrejo.png" class="deco-h deco-h4" alt="">
            </div>

            <div class="wave">
                <svg viewBox="0 0 500 150" preserveAspectRatio="none" style="height: 100%; width: 100%;">
                    <path d="M0,100 C150,220 180,-10 320,100 C370,160 510,80 500,80 L500,150 L0,150 Z"
                        style="stroke: none; fill: #fff;"></path>
                </svg>
            </div>
        </header>

        <a href="#escena-titulo" class="scroll-cue" aria-label="Bajar para empezar">
            <span>Desliza para empezar</span>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6"></path>
            </svg>
        </a>
    </section>

    <!-- Puntos de progreso: van marcando en qué parte de la historia vas -->
    <nav class="scene-dots" aria-label="Progreso de la historia">
        <a href="#escena-inicio" class="dot-link" data-dot aria-label="Inicio"><span class="dot"></span></a>
        <a href="#escena-titulo" class="dot-link" data-dot aria-label="Práctica de matemáticas"><span class="dot"></span></a>
    </nav>

     <section id="escena-titulo" data-scene>

        <strong><p class="onest">Juego Interactivo y de Concientización Marítima</p></strong>

        <div class="nori-dialogo">
            <div class="nori-imagen-wrap">
                <img src="/proyects/imagenes/weavy/nori.png" class="nori-imagen" alt="Nori, el axolote de Weavy">
            </div>

            <div class="burbuja-texto">
                <p class="texto-animado" data-typewriter="¡Hola! Yo soy Nori y necesito tu ayuda para salvar el mar"></p>
            </div>
        </div>

        <br><br>

        <strong><p class="onest1">Descubre Weavy</p></strong>

        <br><br>

        <div class="seccion-video">
            <div class="foto-lateral foto-izquierda">
                <img src="/proyects/imagenes/weavy/fondo2.png" alt="">
            </div>

            <div class="video-central">
                <video controls playsinline poster="/proyects/imagenes/weavy/video-poster.jpg" preload="metadata">
                    <source src="/proyects/imagenes/weavy/video-weavy.mp4" type="video/mp4">
                </video>
            </div>

            <div class="foto-lateral foto-derecha">
                <img src="/proyects/imagenes/weavy/fondo3.png" alt="">
            </div>
        </div>

        <br><br>
    </section>

</BaseLayoutWeavy>

<script>
  const revealEls = document.querySelectorAll('[data-animate]');
  const dots = document.querySelectorAll<HTMLAnchorElement>('.dot-link');
  const scenes = document.querySelectorAll('[data-scene]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReduced || !('IntersectionObserver' in window)) {
    revealEls.forEach((el) => el.classList.add('in-view'));
  } else {
    const revealIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            revealIO.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );
    revealEls.forEach((el) => revealIO.observe(el));
  }

  if (dots.length && scenes.length && 'IntersectionObserver' in window) {
    const sceneIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            dots.forEach((dot) => {
              dot.classList.toggle('is-active', dot.getAttribute('href') === `#${id}`);
            });
          }
        });
      },
      { threshold: 0.5 }
    );
    scenes.forEach((s) => sceneIO.observe(s));
  }

  // Texto animado tipo "máquina de escribir" para el diálogo de Nori
  const typewriterEls = document.querySelectorAll<HTMLElement>('[data-typewriter]');
  if (typewriterEls.length) {
    const typeText = (el: HTMLElement) => {
      const text = el.dataset.typewriter ?? '';
      el.textContent = '';
      el.classList.add('escribiendo');
      let i = 0;
      const speed = 45;
      const tick = () => {
        if (i < text.length) {
          el.textContent += text.charAt(i);
          i++;
          setTimeout(tick, speed);
        } else {
          el.classList.remove('escribiendo');
        }
      };
      tick();
    };

    if (prefersReduced || !('IntersectionObserver' in window)) {
      typewriterEls.forEach((el) => { el.textContent = el.dataset.typewriter ?? ''; });
    } else {
      const typeIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              typeText(entry.target as HTMLElement);
              typeIO.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      typewriterEls.forEach((el) => typeIO.observe(el));
    }
  }
</script>

<style define:vars={{ colorWaveFill: '#ffffff' }}>
@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Baloo+2:wght@600;700&display=swap');

*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Fredoka', Arial, Helvetica, sans-serif;
}

body{
    background-color: white;
    overflow-x: hidden;
}

/* --- sección head con la ola --- */
.header-con-ola{
    position: relative;
    height: 98vh;
    background-image: url('/proyects/imagenes/weavy/fondo1.png');
    background-size: cover;
    background-position: center bottom;
    background-attachment: fixed;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    text-align: center;
    padding-top: 90px; /* espacio para el nav fijo */
    margin-bottom:90px;
}

.imagen-flotante{
    position: absolute;
    top: 200px;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    max-width: 90vw;
    height: auto;
    animation: float 4s ease-in-out infinite;
}

@keyframes float {
    0% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-20px); }
    100% { transform: translateX(-50%) translateY(0); }
}

@keyframes flotar-libre {
    0% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-16px) rotate(6deg); }
    100% { transform: translateY(0) rotate(0deg); }
}

.wave{
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 150px;
    overflow: hidden;
    z-index: 1;
}

.wave svg path{
    fill: var(--colorWaveFill);
}

/* --- imágenes flotando justo debajo de la ola, en el borde del header --- */
.decoracion-header{
    position: absolute;
    bottom: -50px;
    left: 0;
    width: 100%;
    height: 500px;
    pointer-events: none;
    overflow: visible;
    z-index: 2;
}

.deco-h{
    position: absolute;
    width: 150px;
    height: auto;
    filter: drop-shadow(0 6px 10px rgba(0,0,0,0.12));
}

.deco-h1{ left: 6%; bottom: 10px; animation: flotar-libre 5s ease-in-out infinite; }
.deco-h2{ left: 30%; bottom: -25px; width: 200px; animation: flotar-libre 6s ease-in-out infinite 0.6s; }
.deco-h3{ left: 56%; bottom: 5px; width: 220px; animation: flotar-libre 4.5s ease-in-out infinite 1.1s; }
.deco-h4{ right: 5%; bottom: -15px; width: 250px; animation: flotar-libre 5.5s ease-in-out infinite 0.3s; }

@media (max-width: 640px){
    .decoracion-header{ bottom: -30px; height: 70px; }
    .deco-h{ width: 44px; }
    .deco-h2, .deco-h3, .deco-h4{ width: 40px; }
}

.scroll-cue{
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--colorPlum);
    text-decoration: none;
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.02em;
    background: rgba(255, 255, 255, 0.82);
    padding: 8px 16px 10px;
    border-radius: 999px;
    box-shadow: 0 6px 18px rgba(76, 56, 57, 0.18);
    animation: cue-bounce 2s ease-in-out infinite;
}

.scroll-cue svg{ animation: cue-arrow 2s ease-in-out infinite; }

.scene-dots{
    position: fixed;
    right: 22px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.dot-link{
    display: block;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.dot-link .dot{
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(76, 56, 57, 0.28);
    display: block;
    transition: transform 0.25s ease, background 0.25s ease;
}

.dot-link:hover .dot,
.dot-link:focus-visible .dot{
    background: var(--colorCoral);
    transform: scale(1.2);
}

.dot-link.is-active .dot{
    background: var(--colorCoral);
    transform: scale(1.5);
    box-shadow: 0 0 0 3px rgba(94, 201, 255, 0.25);
}

.dot-link:focus-visible{
    outline: 2px solid var(--colorTeal);
    outline-offset: 3px;
    border-radius: 50%;
}

@media (max-width: 640px){
    .scene-dots{ display: none; }
}

/* --- sección de título: contenedor relativo para la decoración --- */
#escena-titulo{
    position: relative;
    overflow: hidden;
    padding: 30px 16px 50px;
    background: linear-gradient(180deg, #ffffff 0%, #eaf6ff 100%);
}

#escena-titulo > *{
    position: relative;
    z-index: 1;
}

.onest{
    font-family: 'Baloo 2', 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: clamp(26px, 5.5vw, 52px);
    text-align: center;
    color: #1c3fa0;
}

.onest1{
    font-family: 'Baloo 2', 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 7vw, 58px);
    text-align: center;
    color: #ff8a3d;
    text-shadow: 3px 3px 0 rgba(28, 63, 160, 0.15);
}

.rebote{
    animation: brincar 1s infinite;
}

@keyframes brincar {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-50px); }
}

/* --- Diálogo animado de Nori --- */
.nori-dialogo{
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    padding: 30px 20px 10px;
    text-align: left;
}

.nori-imagen-wrap{
    flex-shrink: 0;
}

.nori-imagen{
    width: 180px;
    max-width: 45vw;
    height: auto;
    filter: drop-shadow(0 8px 12px rgba(0,0,0,0.15));
    animation: float 4s ease-in-out infinite;
}

.burbuja-texto{
    position: relative;
    background: #fff9ec;
    border: 4px solid #2254d1;
    border-radius: 30px;
    padding: 20px 26px;
    max-width: 440px;
    box-shadow: 0 10px 24px rgba(34, 84, 209, 0.2);
}

.burbuja-texto::after{
    content: '';
    position: absolute;
    left: -20px;
    bottom: 26px;
    border-width: 12px 20px 12px 0;
    border-style: solid;
    border-color: transparent #2254d1 transparent transparent;
}

.texto-animado{
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    font-size: clamp(18px, 2.6vw, 26px);
    color: #16408a;
    min-height: 1.4em;
    line-height: 1.4;
}

.texto-animado.escribiendo::after{
    content: '|';
    display: inline-block;
    margin-left: 2px;
    animation: parpadeo 0.8s steps(1) infinite;
}

@keyframes parpadeo{
    0%, 50%{ opacity: 1; }
    51%, 100%{ opacity: 0; }
}

@media (max-width: 640px){
    .nori-dialogo{
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .burbuja-texto::after{ display: none; }
}

/* --- Video central con fotos a los lados --- */
.seccion-video{
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    flex-wrap: wrap;
    padding: 20px 20px 40px;
    max-width: 1400px;
    margin: 0 auto;
}

.video-central{
    flex: 3 1 700px;
    max-width: 900px;
}

.video-central video{
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 24px;
    border: 5px solid #2254d1;
    box-shadow: 0 14px 34px rgba(0,0,0,0.18);
    display: block;
}

.foto-lateral{
    flex: 1 1 160px;
    max-width: 200px;
}

.foto-lateral img{
    width: 100%;
    height: auto;
    border-radius: 18px;
    border: 4px solid #ff8a3d;
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}

/* en vez de desaparecer, las fotos se reacomodan arriba/abajo del video */
@media (max-width: 900px){
    .seccion-video{
        flex-direction: column;
    }

    .video-central{
        order: 1;
        max-width: 100%;
    }

    .foto-lateral{
        order: 2;
        display: flex;
        justify-content: center;
        max-width: 140px;
    }

    .foto-izquierda{ order: 2; }
    .foto-derecha{ order: 3; }
}

@media (max-width: 480px){
    .foto-lateral{ max-width: 110px; }
}

/* --- Imágenes pequeñas flotando alrededor de la pantalla --- */
.decoracion-flotante{
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 3;
}

.deco{
    position: absolute;
    width: 80px;
    height: auto;
    opacity: 0.7;
}

.deco-1{ top: 6%; left: 4%; animation: flotar-libre 5s ease-in-out infinite; }
.deco-2{ top: 12%; right: 5%; animation: flotar-libre 6s ease-in-out infinite 0.5s; }
.deco-3{ bottom: 8%; left: 6%; width: 64px; animation: flotar-libre 4.5s ease-in-out infinite 1s; }
.deco-4{ bottom: 12%; right: 4%; width: 70px; animation: flotar-libre 5.5s ease-in-out infinite 0.3s; }

@media (max-width: 640px){
    .deco{ width: 48px; }
    .deco-3, .deco-4{ width: 38px; }
}

</style>