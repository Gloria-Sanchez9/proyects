---
import BaseLayoutWeavy from '../../layouts/BaseLayoutWeavy.astro';
---

<BaseLayoutWeavy>
  <section class="game-section">
    <div class="game-wrap">
      <iframe
        src={`${import.meta.env.BASE_URL}games/Weavy/index.html`}
        title="Weavy"
        allow="fullscreen; autoplay; gamepad"
        allowfullscreen
      ></iframe>
    </div>
  </section>
</BaseLayoutWeavy>

<style>
  .game-section {
    padding: 16px 16px 40px;
  }

  /* 16:9 que nunca se sale de la pantalla: limita por ancho y por alto */
  .game-wrap {
    width: min(100%, 1100px, calc((100dvh - 140px) * 16 / 9));
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: 22px;
    overflow: hidden;
    background: #231F20;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
  }

  .game-wrap iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 699px) {
    .game-section { padding: 8px 8px 24px; }
    .game-wrap {
      width: 100%;
      border-radius: 14px;
    }
  }
</style>
