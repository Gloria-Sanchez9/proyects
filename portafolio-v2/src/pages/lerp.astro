---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
<div class="lerp-hero">
  <img class="sticker sticker-estrella sticker-hero-1" src="/proyects/imagenes/lerp/estrella.png" alt="" loading="lazy" decoding="async" />
  <img class="sticker sticker-estrella sticker-hero-2" src="/proyects/imagenes/lerp/estrella.png" alt="" loading="lazy" decoding="async" />

  <p class="lerp-eyebrow">Conoce a</p>
  <h1 class="lerp-wordmark">LERP</h1>
  <p class="lerp-subtitulo">Learning Entity for Recreational Projects</p>

  <div class="lerp-badges">
    <div class="lerp-badge">
      <span class="lerp-badge-icono" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 2a4 4 0 00-4 4c0 .35.04.69.12 1.02A3.5 3.5 0 003 10.5 3.5 3.5 0 004.5 13a3.5 3.5 0 00-.5 1.8A3.7 3.7 0 007.7 18.5c.1.86.5 1.63 1.1 2.18A3.6 3.6 0 0011.5 22V6a4 4 0 00-2.5-4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M15 2a4 4 0 014 4c0 .35-.04.69-.12 1.02A3.5 3.5 0 0121 10.5 3.5 3.5 0 0119.5 13c.32.53.5 1.15.5 1.8a3.7 3.7 0 01-3.7 3.7c-.1.86-.5 1.63-1.1 2.18A3.6 3.6 0 0112.5 22V6a4 4 0 012.5-4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        </svg>
      </span>
      <p>Impulsado por la <span class="lerp-badge-destacado">curiosidad</span></p>
    </div>

    <div class="lerp-badge">
      <span class="lerp-badge-icono" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="12" cy="13" rx="5" ry="6.5" stroke="currentColor" stroke-width="1.4"/>
          <path d="M12 6.5V4M9 5l-1.3-1.6M15 5l1.3-1.6M4.5 10H7M20 10h-2.5M5 15.5l2.2-1M19 15.5l-2.2-1M6.5 20l1.8-2M17.5 20l-1.8-2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </span>
      <p>Amante de los <span class="lerp-badge-destacado">bugs</span></p>
    </div>
  </div>

  <img class="lerp-hero-img" src="/proyects/imagenes/lerp/lerp-laptop.png" alt="LERP, el robot mascota de ELOA, recostado sobre una laptop" fetchpriority="high" decoding="async" />
</div>

<section class="rasgo rasgo-naranja">
  <img class="sticker sticker-mariquita sticker-naranja-1" src="/proyects/imagenes/lerp/mariquita.png" alt="" loading="lazy" decoding="async" />
  <img class="sticker sticker-mariquita sticker-naranja-2" src="/proyects/imagenes/lerp/mariquita.png" alt="" loading="lazy" decoding="async" />
  <div class="rasgo-contenido">
    <img class="rasgo-img" src="/proyects/imagenes/lerp/lerp-bombilla.png" alt="LERP sosteniendo un foco encendido, emocionado" loading="lazy" decoding="async" />
    <div class="rasgo-texto">
      <p class="rasgo-eyebrow">Coleccionista de bugs</p>
      <p class="rasgo-frase">No se asusta con errores — los ve como <strong>"mascotas"</strong>.</p>
      <p class="rasgo-callout">Si el programa falla se emociona, porque encontró algo <strong>"único"</strong>.</p>
    </div>
  </div>
</section>

<section class="rasgo rasgo-morado">
  <img class="sticker sticker-estrella sticker-morado-1" src="/proyects/imagenes/lerp/estrella.png" alt="" loading="lazy" decoding="async" />
  <img class="sticker sticker-lerp-mini sticker-morado-libro" src="/proyects/imagenes/lerp/lerp-libro.png" alt="" loading="lazy" decoding="async" />
  <div class="rasgo-contenido rasgo-contenido-invertido">
    <img class="rasgo-img" src="/proyects/imagenes/lerp/lerp-highfive.png" alt="LERP con los brazos extendidos intentando chocar las manos" loading="lazy" decoding="async" />
    <div class="rasgo-texto">
      <p class="rasgo-eyebrow">El "high-five" fallido</p>
      <p class="rasgo-frase">Siempre intenta chocar las manos para celebrar... pero sus <strong>cálculos de trayectoria</strong> fallan.</p>
      <p class="rasgo-callout">Falla por unos centímetros, o le da a la nada.</p>
    </div>
  </div>
</section>

<section class="rasgo rasgo-azul">
  <img class="sticker sticker-lerp-mini sticker-azul-examen" src="/proyects/imagenes/lerp/lerp-examen.png" alt="" loading="lazy" decoding="async" />
  <div class="rasgo-contenido">
    <img class="rasgo-img" src="/proyects/imagenes/lerp/lerp-proyectando.png" alt="LERP proyectando un dibujo con un pizarrón portátil" loading="lazy" decoding="async" />
    <div class="rasgo-texto">
      <p class="rasgo-eyebrow">Explicaciones con dibujos</p>
      <p class="rasgo-frase">Si tiene que explicar algo, no saca texto aburrido — <strong>proyecta</strong>.</p>
      <p class="rasgo-callout">Garabatos y dibujos que apenas se entienden, pero que son adorables.</p>
    </div>
  </div>
</section>

</BaseLayout>

<style>

@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Montserrat:wght@400;600&display=swap');

:root{
    --font-display: 'Space Grotesk', Arial, sans-serif;
    --font-body: 'Montserrat', 'Arial', sans-serif;
    --navy: #182d42;
    --naranja: #da5d1a;
    --morado: #7f6ab1;
    --azul: #4b77b5;
}

*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

html{
    overflow-x: hidden;
}

body{
    background-color: #F9F9F9;
    overflow-x: hidden;
    margin: 0;
    padding: 0;
}

/* ===== MOBILE FIRST ===== */

.lerp-hero{
    width: 100%;
    min-height: 460px;
    background-color: var(--navy);
    text-align: center;
    padding: 110px 20px 0;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.lerp-eyebrow{
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 1px;
    font-size: 16px;
    color: #ffffff;
    text-transform: uppercase;
}

.lerp-wordmark{
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(56px, 18vw, 110px);
    color: #83a5b6;
    line-height: 1;
    margin: 4px 0;
}

.lerp-subtitulo{
    font-family: var(--font-body);
    font-size: 15px;
    color: #c9d3dd;
    max-width: 320px;
    margin: 0 auto 24px;
}

.lerp-badges{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
}

.lerp-badge{
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255,255,255,0.06);
    border: 0.5px solid rgba(255,255,255,0.18);
    border-radius: 999px;
    padding: 8px 18px 8px 8px;
}

.lerp-badge-icono{
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.lerp-badge-icono svg{
    width: 18px;
    height: 18px;
}

.lerp-badge p{
    font-family: var(--font-body);
    font-size: 14px;
    color: #ffffff;
    text-align: left;
}

.lerp-badge-destacado{
    color: #7ddab0;
    font-weight: 600;
}

.lerp-hero-img{
    width: 100%;
    max-width: 260px;
    height: auto;
    margin-top: auto;
    display: block;
}

/* ===== Secciones de rasgos ===== */

.rasgo{
    width: 100%;
    background-color: #ffffff;
    padding: 40px 20px;
    position: relative;
    overflow: hidden;
}

.rasgo-contenido{
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
}

.rasgo-img{
    width: 100%;
    max-width: 220px;
    height: auto;
}

.rasgo-eyebrow{
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(20px, 5vw, 28px);
    text-transform: uppercase;
    margin-bottom: 10px;
}

.rasgo-frase{
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.6;
    color: #1b2e45;
    margin-bottom: 16px;
}

.rasgo-frase strong{
    font-weight: 600;
}

.rasgo-callout{
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: #1b2e45;
    background: #F9F9F9;
    border-radius: 12px;
    padding: 14px 18px;
    display: inline-block;
}

.rasgo-naranja .rasgo-eyebrow{ color: var(--naranja); }
.rasgo-naranja .rasgo-callout strong{ color: var(--naranja); }

.rasgo-morado{ background-color: #f9f8fc; }
.rasgo-morado .rasgo-eyebrow{ color: var(--morado); }
.rasgo-morado .rasgo-callout strong{ color: var(--morado); }

.rasgo-azul .rasgo-eyebrow{ color: var(--azul); }
.rasgo-azul .rasgo-callout strong{ color: var(--azul); }

/* ===== Stickers decorativos: ocultos en mobile a propósito (no hay espacio limpio
   sin que estorben el texto), aparecen a partir de tablet ===== */

.sticker{
    display: none;
    position: absolute;
    pointer-events: none;
}

.sticker-estrella{
    width: 42px;
    height: auto;
}

.sticker-mariquita{
    width: 48px;
    height: auto;
}

.sticker-lerp-mini{
    width: 100px;
    height: auto;
    border-radius: 8px;
}

.sticker-hero-1{ top: 130px; right: 8%; transform: rotate(-8deg); }
.sticker-hero-2{ top: 60px; left: 10%; transform: rotate(10deg); width: 18px; height: auto; }

.sticker-naranja-1{ top: 24px; left: 6%; transform: rotate(-12deg); }
.sticker-naranja-2{ bottom: 30px; right: 8%; transform: rotate(15deg); }

.sticker-morado-1{ top: 30px; right: 10%; transform: rotate(8deg); }
.sticker-morado-libro{ bottom: 24px; left: 6%; transform: rotate(-6deg); }

.sticker-azul-examen{ top: 24px; right: 7%; transform: rotate(7deg); }

/* ===== 700px+: tablet ===== */
@media (min-width: 700px) {

    .sticker{
        display: block;
    }

    .lerp-hero{
        min-height: 560px;
        padding: 130px 20px 0;
    }

    .lerp-subtitulo{
        font-size: 18px;
        max-width: 420px;
    }

    .lerp-badges{
        flex-direction: row;
        justify-content: center;
        gap: 20px;
    }

    .lerp-hero-img{
        max-width: 320px;
    }

    .rasgo{
        padding: 60px 30px;
    }

    .rasgo-img{
        max-width: 280px;
    }

    .rasgo-frase{
        font-size: 19px;
    }

    .rasgo-callout{
        font-size: 17px;
    }
}

/* ===== 1100px+: escritorio, texto e imagen en fila alternando lados ===== */
@media (min-width: 1100px) {

    .rasgo-contenido{
        flex-direction: row;
        text-align: left;
        gap: 60px;
    }

    .rasgo-contenido-invertido{
        flex-direction: row-reverse;
    }

    .rasgo-img{
        max-width: 320px;
        flex: 1 1 320px;
    }

    .rasgo-texto{
        flex: 1 1 420px;
    }

    .rasgo-callout{
        display: block;
    }

    .arco-lerp-izq{
        width: 300px;
        height: 300px;
        left: -160px;
        top: -80px;
    }

    .sticker-estrella{
        width: 300px;
        height: auto;
    }

    .sticker-mariquita{
        width: 300px;
        height: auto;
    }

    .sticker-lerp-mini{
        width: 300px;
    }
}

</style>