---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
<section class="hero">
    <!-- Mantenemos la estructura original pero con contenedores flexibles -->
    <div class="hero-content">
        <div class="aro1"></div>
        <div class="orbit-container c1-container"><div class="circle c1"></div></div>
        <div class="orbit-container c2-container"><div class="circle c2"></div></div>
        <div class="orbit-container c3-container"><div class="circle c3"></div></div>
        <div class="orbit-container c4-container"><div class="circle c4"></div></div>
        <div class="aro2"></div>
        <div class="orbit-container c5-container"><div class="circle c5"></div></div>
        <div class="orbit-container c6-container"><div class="circle c6"></div></div>
        <div class="orbit-container c7-container"><div class="circle c7"></div></div>
        <div class="orbit-container c8-container"><div class="circle c8"></div></div>
        <div class="tarjeta-central"><img class="logo-central" src="imagenes/inicio/logo1FINALL.png"></div>
    </div>
</section>

<!-- Resto de tu estructura igual -->
<div class="container-lerp1-condel"> 
    <img class="lerp1" src="imagenes/inicio/LERPsalu2.png" />
    <div class="container_delgado">
        <p class="texto-principal">Eat <span class="destacado-naranja">Logic</span> Output <span class="destacado-rosa">Art</span></p>
    </div>
    <div class="container_redes">
        <a href="https://www.instagram.com/eloadevteam"><img class="imagenes_redes" src="imagenes/inicio/instagram.png"></a>
        <img class="imagenes_redes" src="imagenes/inicio/tiktol.png"> 
        <a href="mailto:eloadevteam@gmail.com"><img class="imagenes_redes" src="imagenes/inicio/correo.png"></a>
    </div>
</div>

<div class="titulo-bienvenido"><h2>BIENVENIDOS A</h2></div>

<div class="container_abstracto">
    <div class="logo-texto">
        <img class="logo-bienvenida" src="imagenes/inicio/logoBienvenida.png" />
        <div class="texto-texto">
            <h4>Ingeniería mexicana con propósito.</h4>
            <p class="texto-abstracto">En ELOA, transformamos la teoría en experiencias interactivas...</p>
        </div>
    </div>
</div>
</BaseLayout>

<style>
    /* 1. Reset básico fluido */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    /* 2. El truco del font-size permite que los rem escalen con el tamaño de pantalla */
    html { font-size: 16px; }
    @media (max-width: 1000px) { html { font-size: 12px; } }
    @media (max-width: 600px) { html { font-size: 9px; } }

    body { overflow-x: hidden; background: #F9F9F9; }

    /* Hero responsivo: Usamos unidades relativas (rem) */
    .hero { width: 100%; height: 50rem; position: relative; display: flex; justify-content: center; }
    .hero-content { position: relative; width: 100%; max-width: 1200px; }

    .logo-central { width: 37.5rem; } /* 600px / 16 */
    .tarjeta-central { position: absolute; left: 9.3rem; top: 2.5rem; }

    /* Círculos: mantén tus clases, solo asegura que sean relativas */
    .circle { width: 6.8rem; height: 6.8rem; position: absolute; background-size: cover; }
    
    /* Contenedores de secciones inferiores */
    .container_abstracto { 
        width: 100%; 
        height: auto; 
        min-height: 40rem; 
        display: flex; 
        flex-wrap: wrap; 
        justify-content: center;
        padding: 2rem;
    }

    .container2 { width: 100%; overflow: hidden; }
    
    /* Carrusel */
    .carrusel-container { display: flex; overflow-x: auto; width: 100%; }
    .team-member-cardd { flex: 0 0 18.75rem; height: 34.3rem; }

    /* Animaciones igual */
    .orbit-container { position: absolute; width: 100%; height: 100%; animation: orbitarTrayectoria 20s linear infinite; }
    @keyframes orbitarTrayectoria { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>