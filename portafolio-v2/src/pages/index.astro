<style> 

/* FRAME 1 FIGMA*/
/* General */

*{
    margin: 0; /*espacio dentro de la caja (elemento y borde) */
    padding: 0; /*espacio entre cajas */
    box-sizing:border-box;
    font-family: Arial, Helvetica, sans-serif;
}

html{
    overflow-x: hidden;
}

body{
    background-color: #F9F9F9;
    overflow-x: hidden; /* oculta lo que sale horizontalmente (izq-der) de un contendor*/
    margin: 0;
    padding: 0;
}

/* ===== MOBILE FIRST: base para pantallas chicas ===== */

.logo-central{
    width: 100%;
    max-width: 280px;
    height: 100px;
    object-fit: cover;
    object-position: center;
    border-radius:10px; 
    position:relative;
}

/* Hero (la parte despues del nav)*/

.hero{ 
    text-align:center; 
    padding:110px 15px 55px 15px; /* 110px arriba para que no lo tape el nav fijo */
    position:relative; 
}

/* Tarjeta central (rectangulo con el logo ELOA) */ 

.tarjeta-central{ 
    width:100%; 
    max-width: 280px;
    height:auto;
    margin:0 auto 40px auto; 
    border-radius:10px; 
    position:relative; 
} 

/* Titulo */ 
h1{
    margin-top:20px; 
    font-size:32px;
    color:#624142; 
    text-shadow:2px 2px 5px rgba(0,0,0,0.2); 
} 

h2{
    font-family: 'Oswald', 'Arial Narrow', Arial, sans-serif;
    letter-spacing: -1px;
    font-size:38px; 
    color:black; 
    text-shadow:1px 1px 3px rgba(0,0,0,0.2); 
}

p{ 
    margin-top:15px; 
    font-size:16px; 
    color:black; 
    font-family:Verdana, Geneva, Tahoma, sans-serif;
} 
    
/* Boton */ 

.btn{ 
    margin-top:30px; 
    padding:12px 28px; 
    border:none; 
    border-radius:25px; 
    background:#ADCDCD; 
    font-size:16px; 
    font-weight:bold;
    cursor:pointer; 
    box-shadow:0 4px 8px rgba(0,0,0,0.2); 
} 

/* Circulos de imagenes decorativos: los 8 iconos orbitando y el segundo arco se ocultan en mobile (ver nota arriba); dejamos un arco chico visible para que no se vea vacío */ 

.orbit-container,
.aro2{
    display: none;
}

.aro1{
    display: block;
    position:absolute;
    width: 220px;
    height: 220px;
    border: 15px solid rgba(125, 171, 197);
    border-radius: 50%;
    left: -110px;
    top: 60px;
}

.circle{ 
    position:absolute; /*poner los elementos en una posicion exacta*/
    border-radius:10%;  
} 

.c1{ 
    width:110px; 
    height:110px; 
    left:300px; 
    top: 40px; 
    background-image: url('/proyects/imagenes/inicio/icon1.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
    
} 

.c2{
     width:110px; 
     height:110px; 
     left:-50px; 
     top:380px;
     background-image: url('/proyects/imagenes/inicio/icon2.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute; 
} 

.c3{ 
    width:110px; 
    height:110px; 
    left:280px; 
    top:340px;
    background-image: url('/proyects/imagenes/inicio/icon3.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

.c4{ /*esta es la imagen q no se acomoda*/
    width:110px; 
    height:110px; 
    left:-90px; 
    top:-70px; 
    background-image: url('/proyects/imagenes/inicio/icon4.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

.c5{ 
    width:110px; 
    height:110px; 
    right:10px; 
    top:270px; 
    background-image: url('/proyects/imagenes/inicio/icon5.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

.c6{ 
    width:110px; 
    height:110px; 
    right:-10px; 
    top:700px; 
    background-image: url('/proyects/imagenes/inicio/icon6.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

.c7{  /* esta es la imagen q no se acomoda*/
    width:110px; 
    height:110px; 
    right:-300px; 
    top:380px; 
    background-image: url('/proyects/imagenes/inicio/icon7.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

.c8{ 
    width:110px; 
    height:110px; 
    right:180px; 
    top:460px; 
    background-image: url('/proyects/imagenes/inicio/icon8.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

/* Aro del fondo (el segundo, aro2, se restaura en la media query de escritorio) */ 

.aro2{ /* poner border en vez de background*/
    position:absolute; 
    width:500px; 
    height:500px; 
    border:30px solid rgba(125, 171, 197); 
    border-radius:50%; 
    right:-250px; 
    top:280px; 
}

.container_delgado{
    width: 100%;
    min-height: 100px;
    background-color: #182d42;
    display: flex;
    justify-content: center;
    align-items: center;  
    position: relative;  /* Acepta el z-index pero NO se sale de su caja */
    z-index: 10;   
    padding: 15px 10px;
}

.texto-principal{
    letter-spacing: 3px;
    word-spacing: 6px;
    font-size: 22px;
    font-family: 'Oswald', 'Arial Narrow', Arial, sans-serif;
    font-weight: 600;
    color:#ffffff;
    text-align: center;
}

.destacado-rosa{
    font-family: 'Oswald', 'Arial Narrow', Arial, sans-serif;
    color:#d8a2d8;
}

.destacado-naranja{
    
    font-family: 'Oswald', 'Arial Narrow', Arial, sans-serif;
    color:#da5d1a;
}

.container-lerp1-condel{
    display: flex;
    flex-direction: column; 
    width: 100%;
    align-items: center;
    
    
}

.lerp1{
    width: 90%;
    max-width: 450px;
    height: auto;
}

.imagenes_redes{
    width: 36px;
    height: 36px;   
    transition: transform 0.2s ease;
}

.imagenes_redes:hover {
    transform: scale(1.1);
}

.container_redes{
    width: auto;
    height: auto;
    padding: 15px 0;
    display: flex;             
    justify-content: center;   
    align-items: center;
    gap: 15px;        
}

.titulo-bienvenido{
    transform: rotate(-4deg) translateY(30px);
    margin-bottom: 40px; /* reserva espacio para el translateY, si no el contenedor azul lo tapa */
    text-align: center;
}

.container_abstracto{
    width: 100%;
    height: auto;
    background-color:#182d42 ;
    z-index: 9999;/*este arriba de todo*/
    position: relative; /*esto para que funcione el z-index*/
    display: flex;  
    flex-direction: column;
    align-items: center;           
    padding: 40px 20px;
}

.imagenB{
    width: 100%;
    max-width: 250px;
    height: auto;
    border-radius: 10%;  
    margin: 0 auto;  
}

.logo-texto{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    
}

.texto-texto{
    display: flex;
    justify-content: center; 
    flex-direction: column;
}

h4{
    text-align: center;
    font-size: 18px;
    color: #ddd;
}

.logo-bienvenida{
    margin: 15px auto;
    width: 100%;
    max-width: 280px; 
    border-radius:10px; 

}

.texto-abstracto{
    line-height: 24px;
    margin: 15px auto;
    letter-spacing: 0.5px;
    width: 100%;
    max-width: 340px;
    text-align: justify;
    height: auto;
    font-size: 16px;
    font-family: 'Mulish', 'Lucida Sans', Verdana, sans-serif;
    color:#ffffff;

}

.texto-imagen{
    flex-direction: column;
    display: flex;
    align-items: center;
    height: auto;
    margin: 20px auto;

}

.textoO{
    color: white;
    padding: 10px;
    margin-bottom: 20px;
    width: 100%;
    max-width: 300px; 
    height: auto;
    align-items: center;
    justify-content: center;
    display: flex;
    gap: 10px;
}

.texto-arriba{
    color: white;
    padding: 5px;
    font-size: 20px;
    width: 200px; 
    height: auto;
    font-family: 'Oswald', 'Arial Narrow', Arial, sans-serif;

}

/* FRAME 2 FIGMA*/

h3{
    font-family: 'Oswald', 'Arial Narrow', Arial, sans-serif;
    letter-spacing: 2px;
    font-size:28px; 
    color:black; 
    text-shadow:2px 2px 5px rgba(0,0,0,0.2); 
    text-align: center;
    margin-right: 0;
} 

.container1{
    display: flex;            
    justify-content: center;   
    align-items: center;       
    gap: 30px;                
    flex-wrap: wrap;          
    padding: 10px;
    width: 100%;
    height: 450px;
    background-color: #ADCDCD;
}



/* FRAME 3 FIGMA*/

.container2{
    width: 100%;
    height: auto;
    background-color: #182d42;
    padding: 30px 0;
}

.carrusel-s {
    position: relative;
    width: 90%;
    max-width: 1200px;
    margin: auto;
}

/* Contenedor de scroll */
.carrusel-container {
    overflow-x: auto;
    scrollbar-width: none;
    display: flex;
}

.carrusel-container::-webkit-scrollbar {
    display: none;
}

/* Posters */
.carrusel-tarjetas {
    display: flex;
    gap: 15px;
    padding: 15px;
}

/* Diseño posters */
.team-member-cardd {
    flex: 0 0 250px;
    width: 250px;
    height: 460px;
    background-color: white; 
    border-radius: 5px;
    padding: 20px;
    
    /* Flexbox interno para separar el texto arriba y el logo abajo */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    transition: transform 0.3s ease;
    
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    
    /* Evita que el link rompa el diseño */
    text-decoration: none !important;
    color: inherit;
}

.team-member-cardd:hover {
    transform: translateY(-10px);
    background-color: white;
}

.card1 { background-image: url('/proyects/imagenes/inicio/poster4.png'); }
.card2 { background-image: url('/proyects/imagenes/inicio/poster5.png'); }
.card3 { background-image: url('/proyects/imagenes/inicio/poster1.png'); }
.card4 { background-image: url('/proyects/imagenes/inicio/poster3.png'); }
.card5 { background-image: url('/proyects/imagenes/inicio/poster2.png'); }


/* minilerp */
.card-bottom img {
  max-height: 35px;
  opacity: 0.8;            
}

.card-link {
    text-decoration: none; 
    color: inherit;       
    display: block;     
}


.card-link:hover {
    transform: translateY(-10px);
    background-color: white;
}

/*
Botones 
.nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(255, 255, 255, 0.7);
    color: #624142;
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    font-size: 2rem;
    cursor: pointer;
    z-index: 10;
    transition: 0.3s;
}

.nav-btn:hover { background-color: rgba(255, 255, 255, 0.4); }
.prev-btn { left: -60px; }
.next-btn { right: -60px; }
.prev-btn::after { content: '‹'; }
.next-btn::after { content: '›'; }
*/

/* Esto arregla que el link no corte la carta */
    .link-invisible {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%; 
        width: 100%; 
    }

   
    .link-invisible .card-top h3 {
        margin-top: 0; 
    }

    a.team-member-cardd {
        display: flex;
        text-decoration: none;
        color: inherit;
    }

    a.team-member-cardd h3 {
        margin: 0;
        color: white;
    }
  

    /* El contenedor es el que gira, pero es invisible */
    .orbit-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        animation: orbitarTrayectoria 20s linear infinite;
    }

    /* El círculo adentro tiene la rotación inversa para mantenerse derecho */
    .circle {
        animation: mantenerDerecho 20s linear infinite;
    }

    /* La rotación del contenedor */
    @keyframes orbitarTrayectoria {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* La rotación inversa para que la imagen no gire sobre sí misma */
    @keyframes mantenerDerecho {
        from { transform: rotate(0deg); }
        to { transform: rotate(-360deg); }
    }

    /* Ajuste del centro de giro para cada grupo (para que sigan el arco) */
    .c1-container, .c2-container, .c3-container, .c4-container {
        transform-origin: 100px 200px; /* Centro del primer arco */
    }

    .c5-container, .c6-container, .c7-container, .c8-container {
        transform-origin: calc(100% - 0px) 530px; /* Centro del segundo arco */
    }

/* ===== A partir de aquí, pantallas más grandes (tablet/escritorio): se restauran los valores originales del diseño ===== */
@media (min-width: 700px) {

    .logo-central{
        width: clamp(280px, 35vw, 420px);
        max-width: none;
        height: clamp(100px, 12vw, 150px);
    }

    .hero{
        padding: 90px 20px 55px 20px;
    }

    .tarjeta-central{
        width: clamp(280px, 35vw, 420px);
        max-width: 90%;
        height: auto;
        margin: 0 auto 40px auto;
        left: clamp(0px, 5vw, 50px);
    }

    h1{
        font-size: clamp(38px, 6vw, 60px);
        margin-top: 40px;
    }

    h2{
        letter-spacing: -4px;
        font-size: clamp(40px, 8vw, 80px);
    }

    p{
        font-size: 20px;
    }

    .orbit-container,
    .aro2{
        display: none; /* siguen ocultos en tablet, se activan más adelante cuando ya hay espacio real */
    }

    .aro1{
        width: clamp(220px, 30vw, 500px);
        height: clamp(220px, 30vw, 500px);
        border-width: clamp(15px, 2vw, 30px);
        left: clamp(-110px, -8vw, -94px);
        top: -7px;
    }

    .container_delgado{
        min-height: 100px;
        padding: 0;
    }

    .texto-principal{
        letter-spacing: clamp(3px, 1.5vw, 15px);
        word-spacing: clamp(6px, 2vw, 20px);
        font-size: clamp(28px, 5vw, 60px);
    }

    .lerp1{
        width: 450px;
        max-width: none;
        height: 300px;
    }

    .imagenes_redes{
        width: 56px;
        height: 56px;
    }

    .container_redes{
        width: auto;
        height: auto;
        padding: 7px;
        gap: 15px;
    }

    .titulo-bienvenido{
        transform: rotate(-8deg);
        margin-bottom: 20px;
        text-align: left;
        padding-left: 60px;
    }

    .container_abstracto{
        padding: 0 40px;
    }

    .imagenB{
        max-width: 230px;
    }

    h4{
        font-size: 20px;
    }

    .logo-bienvenida{
        margin: 30px;
        max-width: 500px;
    }

    .texto-abstracto{
        line-height: 30px;
        margin: 40px;
        letter-spacing: 1px;
        max-width: 500px;
        font-size: 20px;
    }

    h3{
        letter-spacing: 4px;
        font-size: clamp(32px, 6vw, 60px);
        text-align: right;
        margin-right: 20px;
    }

    .container2{
        height: 600px;
        padding: 0;
        display: flex;
        align-items: center;
    }

    .carrusel-s{
        top: 0;
        transform: none;
        width: 100%;
        max-width: none;
    }

    .carrusel-tarjetas {
        gap: 20px;
        padding: 10px 20px;
    }

    .team-member-cardd {
        flex: 0 0 300px;
        width: 300px;
        height: 540px;
        padding: 30px;
    }
}

/* ===== A partir de aquí ponemos el texto y la laptop en fila, pero con flex-wrap: 
   si en algún ancho no alcanza el espacio, en vez de encimarse, pasa a la siguiente línea. 
   Así funciona en cualquier dispositivo sin tener que adivinar anchos exactos. ===== */
@media (min-width: 700px) {

    .container_abstracto{
        height: auto;
        min-height: 700px;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 40px;
        clip-path: polygon(0 16%, 100% 0, 100% 80%, 0 100%);
    }

    .logo-texto{
        flex-direction: row;
        flex: 1 1 480px;
        max-width: 750px;
        min-width: 0; /* clave: permite que este bloque se encoja en vez de desbordarse */
        gap: 30px;
        align-items: center;
    }

    .logo-bienvenida{
        flex: 0 0 clamp(180px, 22vw, 260px); /* tamaño estable, ya no compite por espacio con el texto */
        width: clamp(180px, 22vw, 260px);
        max-width: none;
        margin: 0;
    }

    .texto-texto{
        flex: 1 1 220px;
