        </div>

        <div class="aro2"></div>

        <div class="orbit-container c5-container">
            <div class="circle c5"></div>
        </div>
        <div class="orbit-container c6-container">
            <div class="circle c6"></div>
        </div>
        <div class="orbit-container c7-container">
            <div class="circle c7"></div>
        </div>
        <div class="orbit-container c8-container">
            <div class="circle c8"></div>
        </div>
            
