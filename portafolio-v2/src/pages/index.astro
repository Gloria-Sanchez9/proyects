<h3 id="Proyectos">NUESTROS PROYECTOS</h3>

<div class="container2">
    <div class="carrusel-container" id="carruselContainer">
        <div class="carrusel-tarjetas" id="carruselTarjetas">
            <a href="ruta/a/particulas.html" class="team-member-cardd card1"></a>
            <a href="ruta/a/party-problems.html" class="team-member-cardd card2"></a>
            <a href="../calculadoraF/inicio/inicio.html" class="team-member-cardd card3"></a>
            <a href="../calculadoraF/inicio/inicio.html" class="team-member-cardd card4"></a>
            <a href="../coordenadasF/inicio/inicioC.html" class="team-member-cardd card5"></a>
        </div> 
    </div> 
</div>
</BaseLayout>

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, Helvetica, sans-serif; }
    body { background-color: #F9F9F9; overflow-x: hidden; }

    /* Escalado Responsivo del Hero */
    .hero { width: 100%; height: 800px; position: relative; display: flex; justify-content: center; overflow: hidden; }
    .hero-wrapper { position: relative; width: 1200px; height: 100%; transform-origin: top center; transition: transform 0.3s; }
    
    @media (max-width: 1200px) { .hero-wrapper { transform: scale(0.8); } }
    @media (max-width: 900px) { .hero-wrapper { transform: scale(0.6); } }
    @media (max-width: 600px) { .hero-wrapper { transform: scale(0.4); } }

    /* Elementos */
    .logo-central { width: 600px; }
    .tarjeta-central { width: 280px; position: absolute; left: 150px; top: 40px; }
    
    .circle { position: absolute; width: 110px; height: 110px; border-radius: 10%; background-size: cover; }
    /* (Mantén tus clases .c1 a .c8 con las mismas coordenadas, al estar dentro de .hero-wrapper escalarán solas) */

    .aro1 { position: absolute; width: 500px; height: 500px; border: 30px solid #7DABC5; border-radius: 50%; left: -94px; top: -7px; }
    .aro2 { position: absolute; width: 500px; height: 500px; border: 30px solid #7DABC5; border-radius: 50%; right: -250px; top: 500px; }

    .container-lerp1-condel { display: flex; flex-direction: column; width: 100%; align-items: center; }
    
    .container_delgado { width: 100%; height: auto; padding: 20px; background-color: #182d42; display: flex; justify-content: center; }
    .texto-principal { font-size: 3rem; color: white; text-align: center; }

    .container_abstracto { width: 100%; min-height: 700px; background-color: #182d42; display: flex; flex-wrap: wrap; padding: 50px; }
    .logo-bienvenida { width: 100%; max-width: 500px; }
    .texto-abstracto { width: 100%; max-width: 500px; color: white; }

    .container2 { width: 100%; background-color: #182d42; padding: 50px 0; }
    .carrusel-container { overflow-x: auto; display: flex; }
    .carrusel-tarjetas { display: flex; gap: 20px; padding: 20px; }
    .team-member-cardd { flex: 0 0 300px; height: 550px; background-size: cover; }
    
    /* Animaciones */
    .orbit-container { position: absolute; width: 100%; height: 100%; animation: orbitarTrayectoria 20s linear infinite; }
    .circle { animation: mantenerDerecho 20s linear infinite; }
    @keyframes orbitarTrayectoria { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    @keyframes mantenerDerecho { from { transform: rotate(0deg); } to { transform: rotate(-360deg); } }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById('carruselContainer');
        const track = document.querySelector('.carrusel-tarjetas');
        
        // Loop infinito simple
        let scrollPos = 0;
        const animate = () => {
            scrollPos += 1;
            container.scrollLeft = scrollPos;
            if (container.scrollLeft >= (track.scrollWidth / 2)) scrollPos = 0;
            requestAnimationFrame(animate);
        };
        requestAnimationFrame(animate);
    });
</script>