---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
<div id="viewport-wrapper">
    <section class="hero">
        <div class="aro1"></div>
        <div class="orbit-container c1-container"><div class="circle c1" id="Inicio"></div></div>
        <div class="orbit-container c2-container"><div class="circle c2"></div></div>
        <div class="orbit-container c3-container"><div class="circle c3"></div></div>
        <div class="orbit-container c4-container"><div class="circle c4"></div></div>
        <div class="aro2"></div>
        <div class="orbit-container c5-container"><div class="circle c5"></div></div>
        <div class="orbit-container c6-container"><div class="circle c6"></div></div>
        <div class="orbit-container c7-container"><div class="circle c7"></div></div>
        <div class="orbit-container c8-container"><div class="circle c8"></div></div>
        <div class="tarjeta-central">
            <img class="logo-central" src="imagenes/inicio/logo1FINALL.png">
        </div>
    </section>

    <div class="container-lerp1-condel"> 
        <img class="lerp1" src="imagenes/inicio/LERPsalu2.png" />
        <div class="container_delgado">
            <p class="texto-principal">Eat <span class="destacado-naranja">Logic</span> Output <span class="destacado-rosa">Art</span></p>
        </div>
        <div class="container_redes">
            <a href="https://www.instagram.com/eloadevteam" target="_blank" rel="noopener noreferrer">
                <img class="imagenes_redes" src="imagenes/inicio/instagram.png" alt="Instagram" />
            </a>
            <img class="imagenes_redes" src="imagenes/inicio/tiktol.png" /> 
            <a href="mailto:eloadevteam@gmail.com">
                <img class="imagenes_redes" src="imagenes/inicio/correo.png" alt="Correo" />
            </a>
        </div>
    </div>

    <div class="titulo-bienvenido">
        <h2>BIENVENIDOS A</h2>
    </div>

    <div class="container_abstracto">
        <div class="logo-texto">
            <img class="logo-bienvenida" src="imagenes/inicio/logoBienvenida.png" />
            <div class="texto-texto">
                <h4>Ingienería mexicana con propósito.</h4>
                <p class="texto-abstracto"> En ELOA, transformamos la teoría en experiencias interactivas. Somos estudiantes comprometidos con facilitar el aprendizaje a través de juegos y herramientas, creando un ecosistema digital donde educar es divertido y simultáneo. Explora nuestra visión de la tecnología. </p>
            </div>
        </div>
        <div class="texto-imagen">
            <div class="textoO">
                <img src="imagenes/inicio/programacion.png" width="80px" />
                <p class="texto-arriba">Desarrolladores universitarios mexicanos</p>
            </div>
            <img class="imagenB" src="imagenes/inicio/junta.jpg" />
        </div>
    </div> 

    <h3 id="Proyectos">NUESTROS PROYECTOS</h3>

    <div class="container2">
        <div class="carrusel-container" id="carruselContainer">
            <div class="carrusel-tarjetas" id="carruselTarjetas">
                <a href="ruta/a/particulas.html" class="team-member-cardd card1"></a>
                <a href="ruta/a/party-problems.html" class="team-member-cardd card2"></a>
                <a href="../calculadoraF/inicio/inicio.html" class="team-member-cardd card3"></a>
                <a href="../calculadoraF/inicio/inicio.html" class="team-member-cardd card4"></a>
                <a href="../coordenadasF/inicio/inicioC.html" class="team-member-cardd card5"></a>
            </div> 
        </div> 
    </div>
</div>
</BaseLayout>

<style>
    /* Estilos base (NO TOCAR, tus originales) */
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, Helvetica, sans-serif; }
    body { background-color: #F9F9F9; overflow-x: hidden; }
    
    /* Contenedor de escala */
    #viewport-wrapper {
        width: 1200px; /* Tu ancho original */
        transform-origin: top left;
    }

    /* --- TUS ESTILOS ORIGINALES AQUÍ --- */
    .hero{ text-align:center; padding:100px 20px; position:relative; }
    .logo-central{ width: 600px; left:-100px; top: -200px; position:relative; }
    .tarjeta-central{ width:280px; height:140px; left:150px; top:40px; margin:auto; position:relative; }
    .circle{ position:absolute; width:110px; height:110px; border-radius:10%; background-size: cover; background-position: center; }
    .aro1{ position:absolute; width:500px; height:500px; border:30px solid rgba(125, 171, 197); border-radius:50%; left:-94px; top:-7px; }
    .aro2{ position:absolute; width:500px; height:500px; border:30px solid rgba(125, 171, 197); border-radius:50%; right:-250px; top:500px; }
    .container_delgado{ width: 100%; height: 100px; background-color: #182d42; display: flex; justify-content: center; align-items: center; position: relative; z-index: 10; }
    .texto-principal{ letter-spacing: 15px; font-size: 60px; color:#ffffff; }
    .container-lerp1-condel{ display: flex; flex-direction: column; width: 100%; }
    .container_abstracto{ width: 100%; height: 700px; background-color:#182d42; display: flex; align-items: center; }
    .container2{ width: 100%; height: 600px; background-color: #182d42; }
    
    /* Animaciones */
    .orbit-container { position: absolute; width: 100%; height: 100%; animation: orbitarTrayectoria 20s linear infinite; }
    .circle { animation: mantenerDerecho 20s linear infinite; }
    @keyframes orbitarTrayectoria { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    @keyframes mantenerDerecho { from { transform: rotate(0deg); } to { transform: rotate(-360deg); } }
</style>

<script>
    function adjustScale() {
        const wrapper = document.getElementById('viewport-wrapper');
        const screenWidth = window.innerWidth;
        const designWidth = 1200; // Tu ancho base
        
        if (screenWidth < designWidth) {
            const scale = screenWidth / designWidth;
            wrapper.style.transform = `scale(${scale})`;
            document.body.style.overflowX = 'hidden';
        } else {
            wrapper.style.transform = 'scale(1)';
        }
    }

    window.addEventListener('resize', adjustScale);
    window.addEventListener('load', adjustScale);
</script>