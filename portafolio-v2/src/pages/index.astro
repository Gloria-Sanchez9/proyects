---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
<section class="hero">
    <div class="aro1"></div>
    <div class="orbit-container c1-container">
        <div class="circle c1" id="Inicio"></div>
    </div>
    <div class="orbit-container c2-container">
        <div class="circle c2"></div>
    </div>
    <div class="orbit-container c3-container">
        <div class="circle c3"></div>
    </div>
    <div class="orbit-container c4-container">
        <div class="circle c4"></div>
    </div>

    <div class="aro2"></div>

    <div class="orbit-container c5-container">
    <div class="circle c5"></div>
    </div>
    <div class="orbit-container c6-container">
        <div class="circle c6"></div>
    </div>
    <div class="orbit-container c7-container">
        <div class="circle c7"></div>
    </div>
    <div class="orbit-container c8-container">
        <div class="circle c8"></div>
    </div>
        
<div class="tarjeta-central">
    <img class="logo-central" src="/proyects/imagenes/inicio/logo1FINALL.png" alt="Logo de ELOA" fetchpriority="high" decoding="async" />
</div>
</section>

<div class="container-lerp1-condel"> 
    <img class="lerp1" src="/proyects/imagenes/inicio/LERPsalu2.png" alt="" decoding="async" />

    <div class="container_delgado">
        <p class="texto-principal">
        Eat <span class="destacado-naranja">Logic</span> Output <span class="destacado-rosa">Art</span>
    </p>
    </div>
    <div class="container_redes">
        <a href="https://www.instagram.com/eloadevteam" target="_blank" rel="noopener noreferrer">
            <img class="imagenes_redes" src="/proyects/imagenes/inicio/instagram.png" alt="Instagram" decoding="async" />
        </a>
        <a href="mailto:eloadevteam@gmail.com">
            <img class="imagenes_redes" src="/proyects/imagenes/inicio/correo.png" alt="Correo" decoding="async" />
        </a>
    </div>
</div>

<section class="bienvenida">
    <div class="bienvenida-decor bienvenida-decor-izq" aria-hidden="true"></div>
    <div class="bienvenida-decor bienvenida-decor-der" aria-hidden="true"></div>
    <div class="bienvenida-contenido">
        <div class="bienvenida-texto-col">
            <h2 class="bienvenida-titulo">
                Bienvenidos a <span class="destacado-naranja">ELOA</span><br />
                Ingeniería mexicana con propósito
            </h2>
            <p class="texto-abstracto"> En ELOA, transformamos la teoría en experiencias interactivas. Somos estudiantes comprometidos con facilitar el aprendizaje a través de juegos y herramientas, creando un ecosistema digital donde educar es divertido y simultáneo. </p>
            <p class="bienvenida-cta">Explora nuestra visión de la tecnología.</p>
        </div>
        <img class="bienvenida-ilustracion" src="/proyects/imagenes/inicio/nosotros.png" alt="Ilustración estilo caricatura del equipo ELOA junto a su mascota robot, alrededor de una mesa" loading="lazy" decoding="async" />
    </div>
</section>
<br />

<!--FRAME 3 FIGMA -->
<h3 id="Proyectos">NUESTROS PROYECTOS</h3><br />
<br/><br/>

<div class="container2">
  <div class="carrusel-s">
    
    <button class="nav-btn prev-btn" id="prevBtn" aria-label="Anterior" style="display:none;"></button>
    <button class="nav-btn next-btn" id="nextBtn" aria-label="Siguiente" style="display:none;"></button>

    <div class="carrusel-container" id="carruselContainer">
      
      <div class="carrusel-tarjetas" id="carruselTarjetas">
        
        <a href="ruta/a/particulas.html" class="team-member-cardd card1">
          <div class="card-bottom"><img src="/proyects/imagenes/inicio/miniLERP.png" alt="" loading="lazy" decoding="async" /></div>
        </a>

        <a href="/proyects/party-problems/inicioParty" class="team-member-cardd card2">
          <div class="card-bottom"><img src="/proyects/imagenes/inicio/miniLERP.png" alt="" loading="lazy" decoding="async" /></div>
        </a>

        <a href="/proyects/parabolic-pets/inicioPets" class="team-member-cardd card3">
          <div class="card-bottom"><img src="/proyects/imagenes/inicio/miniLERP.png" alt="" loading="lazy" decoding="async" /></div>
        </a>

        <a href="/proyects/Calculadoras/calculadoras" class="team-member-cardd card4">
            <div class="card-bottom"><img src="/proyects/imagenes/inicio/miniLERP.png" alt="" loading="lazy" decoding="async" /></div>
        </a>

        <a href="/proyects/Coordenadas/graficar" class="team-member-cardd card5">
          <div class="card-bottom"><img src="/proyects/imagenes/inicio/miniLERP.png" alt="" loading="lazy" decoding="async" /></div>
        </a>

      </div> 
    </div> 
  </div> 
</div>
</BaseLayout>

<style> 

/* Fuentes nuevas: Space Grotesk para títulos, IBM Plex Mono para el eyebrow "BIENVENIDOS A".
   Idealmente esto se mueve al <head> de BaseLayout.astro como <link>, igual que
   quedamos antes; lo dejo aquí como @import para que funcione de una vez. */
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Mono:wght@500&family=Montserrat:wght@400;600&display=swap');

:root{
    --font-display: 'Space Grotesk', 'Oswald', Arial, sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
    --ink: black;
    --navy: #182d42;
    --bg: #F9F9F9;
}

/* FRAME 1 FIGMA*/
/* General */

*{
    margin: 0; /*espacio dentro de la caja (elemento y borde) */
    padding: 0; /*espacio entre cajas */
    box-sizing:border-box;
    font-family: Arial, Helvetica, sans-serif;
}

html{
    overflow-x: hidden;
}

body{
    background-color: #F9F9F9;
    overflow-x: hidden; /* oculta lo que sale horizontalmente (izq-der) de un contendor*/
    margin: 0;
    padding: 0;
}

/* ===== MOBILE FIRST: base para pantallas chicas ===== */

.logo-central{
    width: 100%;
    max-width: 280px;
    height: 100px;
    object-fit: cover;
    object-position: center;
    border-radius:10px; 
    position:relative;
}

/* Hero (la parte despues del nav)*/

.hero{ 
    text-align:center; 
    padding:110px 15px 55px 15px; /* 110px arriba para que no lo tape el nav fijo */
    position:relative; 
}

/* Tarjeta central (rectangulo con el logo ELOA) */ 

.tarjeta-central{ 
    width:100%; 
    max-width: 280px;
    height:auto;
    margin:0 auto 40px auto; 
    border-radius:10px; 
    position:relative; 
} 

/* Titulo */ 
h1{
    margin-top:20px; 
    font-size:32px;
    color:#624142; 
    text-shadow:2px 2px 5px rgba(0,0,0,0.2); 
} 

h2{
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0px;
    font-size: clamp(1.7rem, 5vw, 2.75rem);
    color: var(--ink);
}

p{ 
    margin-top:15px; 
    font-size:16px; 
    color:black; 
    font-family:Verdana, Geneva, Tahoma, sans-serif;
} 
    
/* Boton */ 

.btn{ 
    margin-top:30px; 
    padding:12px 28px; 
    border:none; 
    border-radius:25px; 
    background:#ADCDCD; 
    font-size:16px; 
    font-weight:bold;
    cursor:pointer; 
    box-shadow:0 4px 8px rgba(0,0,0,0.2); 
} 

/* Circulos de imagenes decorativos: los 8 iconos orbitando y el segundo arco se ocultan en mobile (ver nota arriba); dejamos un arco chico visible para que no se vea vacío */ 

.orbit-container,
.aro2{
    display: none;
}

.aro1{
    display: block;
    position:absolute;
    width: 220px;
    height: 220px;
    border: 15px solid rgba(125, 171, 197);
    border-radius: 50%;
    left: -110px;
    top: 60px;
}

.circle{ 
    position:absolute; /*poner los elementos en una posicion exacta*/
    border-radius:10%;  
} 

.c1{ 
    width:110px; 
    height:110px; 
    left:300px; 
    top: 40px; 
    background-image: url('/proyects/imagenes/inicio/icon1.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
    
} 

.c2{
     width:110px; 
     height:110px; 
     left:-50px; 
     top:380px;
     background-image: url('/proyects/imagenes/inicio/icon2.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute; 
} 

.c3{ 
    width:110px; 
    height:110px; 
    left:280px; 
    top:340px;
    background-image: url('/proyects/imagenes/inicio/icon3.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

.c4{ /*esta es la imagen q no se acomoda*/
    width:110px; 
    height:110px; 
    left:-90px; 
    top:-70px; 
    background-image: url('/proyects/imagenes/inicio/icon4.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

.c5{ 
    width:110px; 
    height:110px; 
    right:10px; 
    top:270px; 
    background-image: url('/proyects/imagenes/inicio/icon5.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

.c6{ 
    width:110px; 
    height:110px; 
    right:-10px; 
    top:700px; 
    background-image: url('/proyects/imagenes/inicio/icon6.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

.c7{  /* esta es la imagen q no se acomoda*/
    width:110px; 
    height:110px; 
    right:-300px; 
    top:380px; 
    background-image: url('/proyects/imagenes/inicio/icon7.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

.c8{ 
    width:110px; 
    height:110px; 
    right:180px; 
    top:460px; 
    background-image: url('/proyects/imagenes/inicio/icon8.png');
    background-size: cover;    /*  la imagen cubre todo el cuadro */
    background-position: center; /* centrar la imagen */
    position: absolute;
} 

/* Aro del fondo (el segundo, aro2, se restaura en la media query de escritorio) */ 

.aro2{ /* poner border en vez de background*/
    position:absolute; 
    width:500px; 
    height:500px; 
    border:30px solid rgba(125, 171, 197); 
    border-radius:50%; 
    right:-250px; 
    top:280px; 
}

.container_delgado{
    width: 100%;
    min-height: 100px;
    background-color: #182d42;
    display: flex;
    justify-content: center;
    align-items: center;  
    position: relative;  /* Acepta el z-index pero NO se sale de su caja */
    z-index: 10;   
    padding: 15px 10px;
}

.texto-principal{
    letter-spacing: 3px;
    word-spacing: 6px;
    font-size: 22px;
    font-family: var(--font-display);
    font-weight: 600;
    color:#ffffff;
    text-align: center;
}

.destacado-rosa{
    font-family: var(--font-display);
    color:#d8a2d8;
}

.destacado-naranja{
    
    font-family: var(--font-display);
    color:#da5d1a;
}

.container-lerp1-condel{
    display: flex;
    flex-direction: column; 
    width: 100%;
    align-items: center;
    
    
}

.lerp1{
    width: 90%;
    max-width: 450px;
    height: auto;
}

.imagenes_redes{
    width: 36px;
    height: 36px;
    object-fit: contain;
    transition: transform 0.2s ease;
}

.imagenes_redes:hover {
    transform: scale(1.1);
}

.container_redes{
    width: auto;
    height: auto;
    padding: 15px 0;
    display: flex;             
    justify-content: center;   
    align-items: center;
    gap: 28px;        
}

.bienvenida{
    position: relative;
    width: 100%;
    background: var(--bg);
    overflow: hidden;
}

.bienvenida-decor{
    display: none;
}

.bienvenida-contenido{
    max-width: 640px;
    margin: 0 auto;
    padding: 48px 24px 56px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
}

.bienvenida-texto-col{
    width: 100%;
}

.bienvenida-ilustracion{
    width: 100%;
    max-width: 420px;
    height: auto;
    border-radius: 16px;
}

.bienvenida-logo{
    width: 64px;
    height: auto;
    margin: 0 auto 18px;
    display: block;
}

.bienvenida-titulo{
    text-align: center;
}

.texto-abstracto{
    line-height: 1.6;
    margin: 14px auto 0;
    letter-spacing: 0.2px;
    width: 100%;
    max-width: 480px;
    text-align: center;
    font-size: 17px;
    font-family: 'Montserrat', 'Arial', sans-serif;
    color: #1b2e45;
}

.bienvenida-cta{
    font-family: 'Montserrat', 'Arial', sans-serif;
    font-weight: 600;
    font-size: 17px;
    line-height: 1.6;
    letter-spacing: 0.2px;
    color: #da5d1a;
    margin: 14px auto 0;
    max-width: 480px;
}

/* FRAME 2 FIGMA*/

h3{
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 1px;
    font-size: 28px;
    color: var(--ink);
    text-align: center;
} 



/* FRAME 3 FIGMA*/

.container2{
    width: 100%;
    height: auto;
    background-color: #182d42;
    padding: 30px 0;
}

.carrusel-s {
    position: relative;
    width: 90%;
    max-width: 1200px;
    margin: auto;
}

/* Contenedor de scroll */
.carrusel-container {
    overflow-x: auto;
    scrollbar-width: none;
    display: flex;
}

.carrusel-container::-webkit-scrollbar {
    display: none;
}

/* Posters */
.carrusel-tarjetas {
    display: flex;
    gap: 15px;
    padding: 15px;
}

/* Diseño posters */
.team-member-cardd {
    flex: 0 0 250px;
    width: 250px;
    height: 460px;
    background-color: white; 
    border-radius: 5px;
    padding: 20px;
    
    /* Flexbox interno para separar el texto arriba y el logo abajo */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    transition: transform 0.3s ease;
    
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    
    /* Evita que el link rompa el diseño */
    text-decoration: none !important;
    color: inherit;
}

.team-member-cardd:hover {
    transform: translateY(-10px);
    background-color: white;
}

.card1 { background-image: url('/proyects/imagenes/inicio/poster4.png'); }
.card2 { background-image: url('/proyects/imagenes/inicio/poster5.png'); }
.card3 { background-image: url('/proyects/imagenes/inicio/poster1.png'); }
.card4 { background-image: url('/proyects/imagenes/inicio/poster3.png'); }
.card5 { background-image: url('/proyects/imagenes/inicio/poster2.png'); }


/* minilerp */
.card-bottom img {
  max-height: 35px;
  opacity: 0.8;            
}

.card-link {
    text-decoration: none; 
    color: inherit;       
    display: block;     
}


.card-link:hover {
    transform: translateY(-10px);
    background-color: white;
}

/* Esto arregla que el link no corte la carta */
    .link-invisible {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%; 
        width: 100%; 
    }

   
    .link-invisible .card-top h3 {
        margin-top: 0; 
    }

    a.team-member-cardd {
        display: flex;
        text-decoration: none;
        color: inherit;
    }

    a.team-member-cardd h3 {
        margin: 0;
        color: white;
    }
  

    /* El contenedor es el que gira, pero es invisible */
    .orbit-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        animation: orbitarTrayectoria 20s linear infinite;
    }

    /* El círculo adentro tiene la rotación inversa para mantenerse derecho */
    .circle {
        animation: mantenerDerecho 20s linear infinite;
    }

    /* La rotación del contenedor */
    @keyframes orbitarTrayectoria {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* La rotación inversa para que la imagen no gire sobre sí misma */
    @keyframes mantenerDerecho {
        from { transform: rotate(0deg); }
        to { transform: rotate(-360deg); }
    }

    /* Ajuste del centro de giro para cada grupo (para que sigan el arco) */
    .c1-container, .c2-container, .c3-container, .c4-container {
        transform-origin: 100px 200px; /* Centro del primer arco */
    }

    .c5-container, .c6-container, .c7-container, .c8-container {
        transform-origin: calc(100% - 0px) 530px; /* Centro del segundo arco */
    }

/* ===== A partir de aquí, pantallas más grandes (tablet/escritorio): se restauran los valores originales del diseño ===== */
@media (min-width: 700px) {

    .logo-central{
        width: 420px;
        max-width: none;
        height: 150px;
    }

    .hero{
        padding: 90px 20px 55px 20px;
    }

    .tarjeta-central{
        width: 420px;
        max-width: 90%;
        height: auto;
        margin: 15px auto 40px auto;
        left: 150px;
    }

    h1{
        font-size: 60px;
        margin-top: 40px;
    }

    h2{
        letter-spacing: 0px;
        font-size: 56px;
    }

    p{
        font-size: 20px;
    }

    .orbit-container,
    .aro1,
    .aro2{
        display: block;
    }

    .aro1{
        width:500px; 
        height:500px; 
        border:30px solid rgba(125, 171, 197); 
        left:-94px; 
        top:-7px; 
    }

    .container_delgado{
        min-height: 100px;
        padding: 0;
    }

    .texto-principal{
        letter-spacing: 15px;
        word-spacing: 20px;
        font-size: 60px;
    }

    .lerp1{
        width: 450px;
        max-width: none;
        height: 300px;
    }

    .imagenes_redes{
        width: 56px;
        height: 56px;
    }

    .container_redes{
        width: auto;
        height: auto;
        padding: 7px;
        gap: 32px;
    }

    .bienvenida-contenido{
        padding: 60px 24px 72px;
    }

    .bienvenida-logo{
        width: 80px;
        margin-bottom: 22px;
    }

    .texto-abstracto{
        margin: 14px auto 0;
        letter-spacing: 0.2px;
        max-width: 560px;
    }

    .bienvenida-cta{
        font-size: 18px;
        max-width: 560px;
    }

    h3{
        letter-spacing: 4px;
        font-size: 60px;
        text-align: right;
        margin-right: 20px;
    }

    .container2{
        height: 600px;
        padding: 0;
        display: flex;
        align-items: center;
    }

    .carrusel-s{
        top: 0;
        transform: none;
        width: 100%;
        max-width: none;
    }

    .carrusel-tarjetas {
        gap: 20px;
        padding: 10px 20px;
    }

    .team-member-cardd {
        flex: 0 0 300px;
        width: 300px;
        height: 540px;
        padding: 30px;
    }
}

/* ===== SOLO PARA TABLETS (iPad y similares), en cualquier orientación: 700px hasta 1099px.
   Aquí SOLO achico los tamaños que en el paso anterior quedaron pensados para pantallas 
   más anchas (compu), para que no se sientan amontonados en una columna angosta.
   No toca nada de <700px (celular) ni de >=1100px (compu). ===== */
@media (min-width: 700px) and (max-width: 1099px) {

    /* Los 8 íconos orbitando y el segundo arco son para escritorio (1366px+);
       en tablet los volvemos a ocultar, dejando solo el arco chico */
    .orbit-container,
    .aro2{
        display: none;
    }

    .aro1{
        display: block;
    }

    .logo-central{
        width: 300px;
        height: 110px;
    }

    .tarjeta-central{
        width: 300px;
        left: 0;
        margin: 15px auto 25px auto;
    }

    h1{
        font-size: 42px;
    }

    h2{
        font-size: 42px;
    }

    .aro1{
        width: 320px;
        height: 320px;
        border-width: 20px;
        left: -70px;
    }

    .texto-principal{
        letter-spacing: 6px;
        word-spacing: 10px;
        font-size: 36px;
    }

    .imagenes_redes{
        width: 44px;
        height: 44px;
    }

    .texto-abstracto{
        margin: 14px auto 0;
        max-width: 480px;
    }

    h3{
        font-size: 40px;
    }

    .team-member-cardd {
        flex: 0 0 260px;
        width: 260px;
        height: 480px;
        padding: 24px;
    }
}

/* ===== Solo en pantallas realmente anchas (computadoras): aquí sí ponemos el texto y la laptop en fila.
   Entre 700px y 1099px (tablets como iPad) se queda en columna, para que nunca se encimen. ===== */
@media (min-width: 1100px) {

    .bienvenida-decor{
        display: block;
        position: absolute;
        border-radius: 50%;
    }

    .bienvenida-decor-izq{
        width: 130px;
        height: 130px;
        border: 12px solid rgba(125, 171, 197, 0.35);
        left: -55px;
        top: 90px;
    }

    .bienvenida-decor-der{
        width: 90px;
        height: 90px;
        border: 10px solid rgba(218, 93, 26, 0.25);
        right: -35px;
        bottom: 50px;
    }

    .bienvenida-contenido{
        max-width: 1100px;
        padding: 76px 40px 96px;
        flex-direction: row;
        align-items: center;
        text-align: left;
        gap: 24px;
    }

    .bienvenida-texto-col{
        flex: 1 1 560px;
        max-width: 620px;
