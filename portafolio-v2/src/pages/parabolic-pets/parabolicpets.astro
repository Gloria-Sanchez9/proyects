---
import BaseLayoutPets from '../../layouts/BaseLayoutPets.astro';
---

<BaseLayoutPets>
  <div class="game-wrap">
    <iframe
      src={`${import.meta.env.BASE_URL}games/parabolicpets/index.html`}
      title="Parabolic Pets"
      loading="lazy"
      allowfullscreen
    ></iframe>
  </div>
</BaseLayoutPets>

<style>
  .game-wrap {
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
  }
  .game-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 22px;
  }
</style>