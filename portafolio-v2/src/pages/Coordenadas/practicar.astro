---
import BaseLayoutCoord from '../../layouts/BaseLayoutCoord.astro';
---

<BaseLayoutCoord>

  <section class="desafio">

    <!-- Círculos decorativos de fondo -->
    <span class="circulo circulo-top-left"></span>
    <span class="circulo circulo-right"></span>

    <div class="contenido">
      <h1>DESAFÍO DE COORDENADAS</h1>
      <p class="subtitulo">
        Pon a prueba tu lógica.<br>
        Resuelve problemas reales y comprueba tus resultados al instante.
      </p>

      <p class="seccion-titulo centrado">Conversiones</p>
      <div class="fila-botones">
        <!-- TODO: apunta al link/página real de ejercicios de conversión SRC -> SCE -->
        <a href="#popupConversion1" class="pill pill-naranja"><button>SRC - SCE</button></a>
        <!-- TODO: apunta al link/página real de ejercicios de conversión SCC -> SCE -->
        <a href="#popupConversion2" class="pill pill-naranja"><button>SCC - SCE</button></a>
      </div>

       <div id="popupConversion1" class="popup">
    <div class="popup-contenido">
      <a href="#">
        <span class="cerrar">&times;</span>
      </a>
      <!-- TODO: ajusta la ruta/cantidad de imágenes de los pasos en papel -->
      <img class="popup-img" src="/proyects/imagenes/coordenadas/SCR-SCEejer/1.png" alt="Ejercicio de conversión SRC a SCE, paso 1" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/SCR-SCEejer/2.png" alt="Ejercicio de conversión SRC a SCE, paso 2" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/SCR-SCEejer/3.png" alt="Ejercicio de conversión SRC a SCE, paso 3" loading="lazy" decoding="async">
    </div>
  </div>

   <div id="popupConversion2" class="popup">
    <div class="popup-contenido">
      <a href="#">
        <span class="cerrar">&times;</span>
      </a>
      <!-- TODO: ajusta la ruta/cantidad de imágenes de los pasos en papel -->
      <img class="popup-img" src="/proyects/imagenes/coordenadas/SCC-SCEejer/1.png" alt="Ejercicio de conversión SCC a SCE, paso 1" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/SCC-SCEejer/2.png" alt="Ejercicio de conversión SCC a SCE, paso 2" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/SCC-SCEejer/3.png" alt="Ejercicio de conversión SCC a SCE, paso 3" loading="lazy" decoding="async">
    </div>
  </div>

      <div class="columna-desafio">
        <p class="seccion-titulo">Distancia entre dos puntos</p>

        <!-- TODO: apunta al link/página real de ejercicios de d(B,A) -->
        <a href="#popupConversion3" class="pill pill-navy offset-0"><button>d( B, A )</button></a>
        <!-- TODO: apunta al link/página real de ejercicios de rho negativa -->
        <a href="#popupConversion4" class="pill pill-navy offset-1"><button>RHO NEGATIVA</button></a>


<div id="popupConversion3" class="popup">
    <div class="popup-contenido">
      <a href="#">
        <span class="cerrar">&times;</span>
      </a>
      <!-- TODO: ajusta la ruta/cantidad de imágenes de los pasos en papel -->
      <img class="popup-img" src="/proyects/imagenes/coordenadas/B-Aejer/1.png" alt="Ejercicio de distancia entre dos puntos, paso 1" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/B-Aejer/2.png" alt="Ejercicio de distancia entre dos puntos, paso 2" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/B-Aejer/3.png" alt="Ejercicio de distancia entre dos puntos, paso 3" loading="lazy" decoding="async">
    </div>
  </div>

        <div id="popupConversion4" class="popup">
    <div class="popup-contenido">
      <a href="#">
        <span class="cerrar">&times;</span>
      </a>
      <!-- TODO: ajusta la ruta/cantidad de imágenes de los pasos en papel -->
      <img class="popup-img" src="/proyects/imagenes/coordenadas/rho/1.png" alt="Ejercicio de rho negativa, paso 1" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/rho/2.png" alt="Ejercicio de rho negativa, paso 2" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/rho/3.png" alt="Ejercicio de rho negativa, paso 3" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/rho/4.png" alt="Ejercicio de rho negativa, paso 4" loading="lazy" decoding="async">
    </div>
  </div>

        <p class="seccion-titulo">Graficar</p>
        <!-- TODO: apunta al link/página real de ejercicios de graficar -->
        <a href="#popupConversion6" class="pill pill-verde offset-0"><button>EJERCICIOS</button></a>
      </div>

      <div id="popupConversion6" class="popup">
    <div class="popup-contenido">
      <a href="#">
        <span class="cerrar">&times;</span>
      </a>
      <!-- TODO: ajusta la ruta/cantidad de imágenes de los pasos en papel -->
      <img class="popup-img" src="/proyects/imagenes/coordenadas/graficarEjer/1.png" alt="Ejercicio de graficar, paso 1" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/graficarEjer/2.png" alt="Ejercicio de graficar, paso 2" loading="lazy" decoding="async">
      <img class="popup-img" src="/proyects/imagenes/coordenadas/graficarEjer/3.png" alt="Ejercicio de graficar, paso 3" loading="lazy" decoding="async">
    </div>
  </div>

      <img
        class="robot"
        src="/proyects/imagenes/coordenadas/robot.png"
        alt="Robot ELOA"
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none'"
      />
    </div>

  </section>

</BaseLayoutCoord>

<style>
  .desafio {
    position: relative;
    max-width: 950px;
    margin: 0 auto;
    padding: 110px 1.25rem 3rem;
    overflow: hidden;
  }

  .contenido {
    position: relative;
    z-index: 2;
    max-width: 480px;
    margin: 0 auto;
  }

  h1 {
    color: #0d1b4c;
    font-family: 'Segoe UI', sans-serif;
    font-weight: 800;
    font-size: clamp(1.4rem, 5vw, 2.1rem);
    letter-spacing: 0.5px;
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .subtitulo {
    color: #555;
    font-family: 'Segoe UI', sans-serif;
    font-size: clamp(0.8rem, 2.5vw, 0.95rem);
    text-align: center;
    line-height: 1.4;
    margin: 0 0 1.75rem;
  }

  .seccion-titulo {
    color: #0d1b4c;
    font-family: 'Segoe UI', sans-serif;
    font-weight: 700;
    font-size: clamp(0.9rem, 2.8vw, 1.05rem);
    margin: 0 0 0.9rem;
  }

  .seccion-titulo.centrado {
    text-align: center;
  }

  /* ---------- Fila de conversiones (naranja) ---------- */
  .fila-botones {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 2rem;
  }

  /* ---------- Columna del desafío (escalonada) ---------- */
  .columna-desafio {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .columna-desafio .seccion-titulo {
    margin-top: 0.5rem;
  }

  .columna-desafio .seccion-titulo:first-child {
    margin-top: 0;
  }

  .offset-0 {
    margin-left: 0;
  }

  .offset-1 {
    margin-left: clamp(2rem, 12vw, 4rem);
  }

  /* ---------- Botones tipo píldora ---------- */
  .pill {
    display: inline-block;
    text-decoration: none;
  }

  .pill button {
    border: none;
    border-radius: 30px;
    padding: 0.8rem 2.2rem;
    font-family: 'Segoe UI', sans-serif;
    font-weight: bold;
    font-size: clamp(0.85rem, 2.6vw, 1rem);
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.3s ease;
    color: white;
  }

  .pill button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
  }

  .pill-naranja button {
    background-color: #e8632a;
    padding: 0.85rem 2.5rem;
  }

  .pill-navy button {
    background-color: #0d1b4c;
  }

  .pill-verde button {
    background-color: #7a8c3f;
  }

  .robot {
    display: block;
    width: clamp(140px, 40vw, 220px);
    height: auto;
    margin: 2rem 0 0 auto;
    opacity: 0.9;
  }

  /* ---------- Círculos decorativos ---------- */
  .circulo {
    position: absolute;
    border-radius: 50%;
    border: 14px solid #a9c8dd;
    opacity: 0.6;
    z-index: 1;
  }

  .circulo-top-left {
    width: 150px;
    height: 150px;
    top: -50px;
    left: -60px;
  }

  .circulo-right {
    width: 200px;
    height: 200px;
    bottom: 10px;
    right: -80px;
  }

  @media (max-width: 480px) {
    .offset-1 {
      margin-left: 2rem;
    }
  }

  @media (min-width: 700px) {
    .desafio {
      padding-top: 130px;
    }
  }

  .popup {
    display: none;
    position: fixed;
    z-index: 20;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.5);
  }

  .popup:target {
    display: block;
  }

  .popup-contenido {
    background-color: #fefefe;
    margin: 8% auto;
    padding: 20px;
    border-radius: 15px;
    border: 3px solid #0d1b4c;
    width: 85%;
    max-width: 600px;
    position: relative;
    text-align: center;
    max-height: 80vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .popup-img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .cerrar {
    position: sticky;
    top: 0;
    display: inline-block;
    color: #aaa;
    align-self: flex-end;
    font-size: 28px;
    font-weight: bold;
    text-decoration: none;
  }

  .cerrar:hover,
  .cerrar:focus {
    color: #d95d1e;
  }
</style>