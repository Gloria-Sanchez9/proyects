---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Para agregar otro game jam: copia un bloque y cambia sus datos.
// "imagen" es opcional (ruta dentro de public/); si no hay, se usa el color.
// Cuando su página ya esté lista, quítale "enProgreso: true".
const gamejams = [
  {
    nombre: 'The Bound Anthology',
    desc: 'Novela visual colaborativa',
    href: '/proyects/gamejams/BoundAnthology/inicioBound',
    color: '#5ecba6',
    imagen: '',
    enProgreso: true, // muestra la ventana "Trabajo en progreso" en vez de abrir la página
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="aro" aria-hidden="true"></div>

    <img class="lerp" src="/proyects/imagenes/lerp/lerp-highfive.webp" alt="LERP, la mascota de ELOA, saludando con los brazos arriba" width="437" height="360" fetchpriority="high" />
    <h1>Eat logic. Output art.</h1>
    <p class="subtitle">
      Ingeniería mexicana con propósito — juegos y herramientas educativas.
    </p>

    <div class="social-icons">
      <a href="https://www.instagram.com/eloadevteam" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="20" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
        </svg>
      </a>
      <a href="mailto:eloadevteam@gmail.com" aria-label="Correo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m2 6 10 7 10-7" />
        </svg>
      </a>
    </div>
  </section>

  <section class="projects-section">
    <p class="eyebrow">Game Jams de ELOA</p>
    <p class="intro">
      En los game jams creamos juegos completos en pocos días: retos donde
      probamos ideas nuevas, aprendemos rápido y trabajamos en equipo.
    </p>

    <h2 class="projects-title">Nuestros game jams</h2>

    <div class="project-grid">
      {gamejams.map((g) => (
        <a class="project-card" href={g.href} data-en-progreso={g.enProgreso ? 'true' : undefined}>
          <div
            class="thumb"
            style={g.imagen
              ? `background:${g.color} url('${g.imagen}') center/cover no-repeat`
              : `background:${g.color}`}
          ></div>
          <div class="card-body">
            <h3>{g.nombre}</h3>
            <p>{g.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- MODAL: Trabajo en progreso (igual al de la página de inicio) -->
  <div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true" aria-labelledby="modalTitulo">
    <div class="modal-box">
      <button class="modal-close" id="modalClose" aria-label="Cerrar">×</button>
      <h2 id="modalTitulo">Trabajo en progreso</h2>
      <img class="modal-image" src="/proyects/imagenes/inicio/lerpBombilla.png" alt="LERP pensando con un foco" />
    </div>
  </div>
</BaseLayout>

<script>
  const modalOverlay = document.getElementById('modalOverlay');
  const modalClose = document.getElementById('modalClose');

  const abrir = () => modalOverlay?.classList.add('activo');
  const cerrar = () => modalOverlay?.classList.remove('activo');

  document.querySelectorAll('[data-en-progreso]').forEach((tarjeta) => {
    tarjeta.addEventListener('click', (e) => {
      e.preventDefault();
      abrir();
    });
  });

  modalClose?.addEventListener('click', cerrar);
  modalOverlay?.addEventListener('click', (e) => {
    if (e.target === modalOverlay) cerrar();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrar();
  });
</script>

<style is:global>
  /* quita el margen blanco que pone el navegador alrededor de la página */
  body { margin: 0; }
</style>

<style>
  .hero,
  .projects-section {
    --navy: #172033;
    --accent-orange: #e8703a;
    box-sizing: border-box;
  }

  /* HERO */
  .hero {
    background: #fafbfc;
    text-align: center;
    padding: 9rem 1.5rem 4rem; /* deja espacio para el nav fijo */
    position: relative;
    overflow: hidden;
    color: #1a1a2e;
  }

  .aro {
    position: absolute;
    top: 40px;
    left: -110px;
    width: 220px;
    height: 220px;
    border: 14px solid #cfe0ea;
    border-radius: 50%;
    pointer-events: none;
  }

  .lerp {
    display: block;
    width: auto;
    height: 150px;
    margin: 0 auto 1.25rem;
    position: relative;
    animation: lerp-flota 3.5s ease-in-out infinite;
  }

  @keyframes lerp-flota {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .lerp { animation: none; }
  }

  .hero h1 {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    font-weight: 700;
    margin: 0 0 0.75rem;
    position: relative;
  }

  .subtitle {
    font-family: 'Mulish', system-ui, sans-serif;
    color: #6b7280;
    max-width: 30rem;
    margin: 0 auto 1.75rem;
    line-height: 1.5;
    position: relative;
  }

  .social-icons {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    position: relative;
  }

  .social-icons a {
    color: #374151;
    transition: color 0.2s ease;
  }

  .social-icons a:hover {
    color: var(--navy);
  }

  /* GAME JAMS */
  .projects-section {
    background: var(--navy);
    color: #fff;
    padding: 3rem clamp(1.25rem, 4vw, 3rem) 4.5rem;
  }

  .eyebrow {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    color: var(--accent-orange);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    margin: 0 0 0.5rem;
  }

  .intro {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    max-width: 40rem;
    line-height: 1.6;
    color: #dbe1ea;
    margin: 0 0 2.5rem;
    font-size: 1.05rem;
  }

  .projects-title {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 1.5rem;
    color: #fff;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 800px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #1e2940;
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);
  }

  .thumb {
    height: 150px;
    width: 100%;
  }

  .card-body {
    padding: 1rem 1.1rem 1.25rem;
  }

  .card-body h3 {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
  }

  /* MODAL: Trabajo en progreso */
  .modal-overlay {
    display: flex;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.25s ease, visibility 0s linear 0.25s;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    z-index: 20000; /* por encima del nav fijo */
    padding: 20px;
  }

  .modal-overlay.activo {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.25s ease, visibility 0s;
  }

  /* Efecto pop: la ventana crece desde chiquita con un pequeño rebote */
  .modal-overlay .modal-box {
    transform: scale(0.6);
    opacity: 0;
    transition: transform 0.2s ease-in, opacity 0.2s ease-in;
  }

  .modal-overlay.activo .modal-box {
    animation: pop-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes pop-in {
    0%   { transform: scale(0.6); opacity: 0; }
    60%  { opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }

  .modal-overlay.activo .modal-image {
    animation: lerp-salta 0.6s ease-out 0.25s both;
  }

  @keyframes lerp-salta {
    0%   { transform: translateY(12px) rotate(-6deg); }
    50%  { transform: translateY(-6px) rotate(3deg); }
    100% { transform: translateY(0) rotate(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .modal-overlay,
    .modal-overlay .modal-box { transition: none; }
    .modal-overlay.activo .modal-box,
    .modal-overlay.activo .modal-image { animation: none; transform: none; opacity: 1; }
  }

  .modal-box {
    background: #F9F9F9;
    border-radius: 12px;
    padding: 32px;
    max-width: 90%;
    max-height: 85vh;
    overflow-y: auto;
    text-align: center;
    position: relative;
  }

  .modal-box h2 {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 26px;
    color: #172033;
    margin: 0;
  }

  .modal-close {
    position: absolute;
    top: 8px;
    right: 14px;
    background: none;
    border: none;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    color: #172033;
  }

  .modal-image {
    margin-top: 18px;
    max-width: 30vh;
    max-height: 30vh;
    border-radius: 8px;
  }

  .card-body p {
    font-family: 'Mulish', system-ui, sans-serif;
    margin: 0;
    font-size: 0.85rem;
    color: #b6bfcf;
  }
</style>
