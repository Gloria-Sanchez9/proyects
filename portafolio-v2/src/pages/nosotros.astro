}

/* arcos*/
    .arco {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    border: 30px solid var(--azul-claro);
    z-index: 1; 
    }
    .arco-izquierdo { 
        left: -250px; 
        top: 100px;
        
    }
    .arco-derecho1 { 
        right: -380px; 
        top:-500px
    }

    .arco-derecho2 { 
        right: -100px; 
        top: 600px
    }

.lerp_naranja{
    position: absolute;
    bottom: 10px; 
    left: 10px;   
    width: 200px;  
}

.img_integrante1{
  border-radius:10px; 
  height: 300px;
}

.container_integrante_info1{
  display: flex;
  flex-direction: column;
  gap: 20px; 
  align-items: center; 
  padding:40px;
  height: 300px;
  width: 1000px;
}

.titulo_integrante1{
    text-align: top;
    font-family: 'Franklin Gothic Medium';
    font-size:28px; 
    color:white; 
    text-shadow:1px 1px 3px rgba(0,0,0,0.1); 
}

.texto_integrante1{
  color: white;
  font-family: 'Montserrat', 'Arial', sans-serif;
  font-size: 20px;
  line-height: 1.6; 
  margin: 0;
  text-align:center;
}

.img_esquina1{
  position: absolute;
    bottom: 10px; 
    right: 10px;   
