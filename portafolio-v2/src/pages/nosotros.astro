}

.tarjeta-foto-contenedor {
    width: 200px;  
    height: 300px; 
    perspective: 1000px;
    cursor: pointer;
    flex-shrink: 0; 
}

/* el giro */
.tarjeta-foto-flipper {
    width: 100%;
    height: 100%;
    position: relative;
    transition: transform 0.6s ease;
    transform-style: preserve-3d;
}

/*  giro al hacer clic */
.tarjeta-foto-contenedor.girar .tarjeta-foto-flipper {
    transform: rotateY(180deg);
}


.tarjeta-foto-flipper .lado {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    backface-visibility: hidden;
    border-radius: 10px;
    overflow: hidden;
}

.tarjeta-foto-flipper .frente {
    z-index: 2;
}

.tarjeta-foto-flipper .atras {
    transform: rotateY(180deg);
}

.tarjeta-foto-flipper .lado img.img_integrante1 {
    width: 95%;
    height: 100%;
    object-fit: cover;
    margin: 0;
}

