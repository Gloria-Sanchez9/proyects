<style> 
*{
    margin: 0; /*espacio dentro de la caja (elemento y borde) */
    padding: 0; /*espacio entre cajas */
    box-sizing:border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body{
    background-color: #F9F9F9;
    overflow-x: hidden; /* oculta lo que sale horizontalmente (izq-der) de un contendor*/
    margin: 0;
    padding: 0;
}

.container_delgado{
    width: 100%;
    height: 500px;
    background-color: #182d42;
    display: flex;
    justify-content: space-between; /* Manda el texto arriba y la imgen abajo de todo*/
    align-items: center;  
    position: relative;  /* Acepta el z-index pero NO se sale de su caja */
    z-index: 10;   
    flex-direction: column;
    padding-bottom: 0;
}

.texto-principal{
    letter-spacing: 15px;
    word-spacing: 20px;
    font-size: 60px;
    font-family: 'Franklin Gothic Medium';
    color:#ffffff;
}

.destacado-rosa{
    font-family: 'Franklin Gothic Medium';
    color:#d8a2d8;
}

.destacado-naranja{
    
    font-family: 'Franklin Gothic Medium';
    color:#da5d1a;
}

.mas-alla-seccion {
  background-color: #fcfcfc; 
  padding: 80px 20px;
  display: flex;
  justify-content: center; 
}

.contenedor-principal {
  display: flex;
  align-items: center; 
  justify-content: space-between; 
  max-width: 1000px; 
  width: 100%;
  gap: 60px; 
}


.columna-texto {
  flex: 1; 
  display: flex;
  flex-direction: column;
  gap: 25px; 
  text-align: justify; 
}

.titulo-azul {
  color: #83a5b6; 
  font-family: 'Oswald', sans-serif;
  font-size: 65px;
  font-weight: 700; 
  margin: 0;
  line-height: 1; 
  text-transform: uppercase;
}

.parrafo-normal {
  color: #1b2e45;
  font-family: 'Montserrat', 'Arial', sans-serif;
  font-size: 23px;
  line-height: 1.6; 
  margin: 0;
}

.frase-naranja {
  color: #d46b42; 
  font-family: 'Franklin Gothic Medium';
  font-size: 36px;
  font-weight: 700;
  margin: 20px 0 0 0; 
  line-height: 1.3;
  text-transform: uppercase;
}

/* iconos*/
.columna-iconos {
  display: flex;
  flex-direction: column;
  gap: 40px; 
  align-items: center; 
}

.columna-iconos img {
  width: 110px; 
  height: auto; 
  opacity: 0.9; 
}

.container_abstracto1{
    width: 100%;
    height: 250px;
    background-color: #182d42 ;
    z-index: 9999;/*este arriba de todo*/
    position: relative; /*esto para que funcione el z-index*/
    display: flex;  
    align-items: center;           
    /* Orden de los puntos: Arriba-Izquierda, Arriba-Derecha, Abajo-Derecha, Abajo-Izquierda */
    clip-path: polygon(0 25%, 100% 10, 100% 80%, 0 100%);      
}

.container_abstracto2{
    width: 100%;
    height: 250px;
    background-color: #182d42 ;
    z-index: 9999;/*este arriba de todo*/
    position: relative; /*esto para que funcione el z-index*/
    display: flex;  
    align-items: center;           
    /* Orden de los puntos: Arriba-Izquierda, Arriba-Derecha, Abajo-Derecha, Abajo-Izquierda */
    clip-path: polygon(0 0, 100% 25%, 100% 100%, 0 80%);      
}

.titulo_mision{
    transform: rotate(4deg) translateY(30px);
    margin-bottom: 0;
    text-align: right;
    padding:30px;
}

.texto_mision{
    transform: rotate(2deg) translateY(30px);
    text-align: center;
    color: white;
    font-family:  'Franklin Gothic Medium';
    font-size: 30px;
}

.mini_texto_mision {
    transform: translateY(-20px) rotate(2deg); 
    color: #4b77b5;
    font-family: 'Franklin Gothic Medium';
    font-size: 25px;
    
    
    /*para que funcione el carrusel en su lugar */
    overflow: hidden; 
    white-space: nowrap;
    width: 100%;
}

.carrusel-track {
    display: inline-flex;
    gap: 40px;
    animation: deslizar 15s linear infinite; /* Velocidad carrusel */
}

/* Animación continua de desplazamiento */
@keyframes deslizar {
    0% {
        transform: translateX(0);
    }
    100% {
        transform: translateX(-50%);
    }
}

.titulo_vision{
    transform: rotate(-4deg) translateY(30px);
    margin-bottom: 0;
    padding:30px;
}

.texto_vision{
    transform: rotate(-2deg) translateY(30px);
    text-align: center;
    padding:50px;
    color: white;
    font-family:  'Franklin Gothic Medium';
    font-size: 30px;
}

.mini_texto_vision {
    transform: rotate(-2deg) translateY(-25px);
    color: #4b77b5;
    font-family:  'Franklin Gothic Medium';
    font-size: 25px;
    
    
    /*para que funcione el carrusel en su lugar */
    overflow: hidden; 
    white-space: nowrap;
    width: 100%;
}

.carrusel-track {
    display: inline-flex;
    gap: 40px;
    animation: deslizar 15s linear infinite; /* Velocidad carrusel */
}

/* Animación continua de desplazamiento */
@keyframes deslizar {
    0% {
        transform: translateX(0);
    }
    100% {
        transform: translateX(-50%);
    }
}


.titulo_vision_mision{
  color: #1b2e45; 
  font-family: 'Oswald', sans-serif;
  font-size: 80px;
  font-weight: 700; 
  margin: 0;
  line-height: 1; 
  text-transform: uppercase;
}

h2{
    font-family: 'Franklin Gothic Medium';
    letter-spacing: -4px;
    font-size:80px; 
    color:black; 
    text-shadow:1px 1px 3px rgba(0,0,0,0.2); 
}

.container_equipo{
    background-color: #ffffff; 
    width: 100%;                    
    margin: 0 auto;            
    padding: 10px;        /* Espacio interno */
    display: flex;
    flex-direction: column;    
    gap: 30px;    
    position: relative;             
}

.titulo-equipo{
    font-family: 'Oswald', sans-serif;
