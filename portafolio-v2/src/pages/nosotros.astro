    font-size:90px; 
    color:#182d42; 
    text-shadow:1px 1px 3px rgba(0,0,0,0.2); 
    text-align:center;
}

.titulo-equipo1{
    font-family: 'Oswald', sans-serif;
    font-size:25px; 
    color:#182d42; 
    text-shadow:1px 1px 3px rgba(0,0,0,0.2); 
