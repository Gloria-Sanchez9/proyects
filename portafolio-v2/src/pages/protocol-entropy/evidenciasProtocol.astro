---
import BaseLayoutProtocol from '../../layouts/BaseLayoutProtocol.astro';

// Cuando tengan fotos: pon la ruta en "imagen" (dentro de public/).
const eventos = [
  {
    nombre: 'MexIHC 2026, Ensenada',
    fotos: ['', '', '', ''],
  },
];
---

<BaseLayoutProtocol title="Evidencias | Protocol Entropy">
  <section class="evidencias">
    <div class="glow" aria-hidden="true"></div>
    <h1 class="titulo">Evidencias</h1>

    {eventos.map((ev) => (
      <div class="evento">
        <h2>{ev.nombre}</h2>
        <div class="galeria">
          {ev.fotos.map((foto, i) => (
            foto ? (
              <img src={foto} alt={`${ev.nombre}, foto ${i + 1}`} loading="lazy" decoding="async" />
            ) : (
              <div class="holder" role="img" aria-label={`Foto ${i + 1} (placeholder)`}>
                <span>foto {i + 1} · placeholder</span>
              </div>
            )
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayoutProtocol>

<style>
  .evidencias {
    position: relative;
    overflow: hidden;
    min-height: 80vh;
    padding: 140px 6vw 100px;
    background: linear-gradient(180deg, #1c0207 0%, #050304 60%);
  }

  .glow {
    position: absolute;
    width: 520px;
    height: 320px;
    top: 40px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 0, 40, 0.22);
    filter: blur(80px);
    border-radius: 50%;
    pointer-events: none;
  }

  .titulo {
    position: relative;
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.8rem, 5vw, 3rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 3rem;
    color: #f2e9ea;
    text-shadow: 0 0 20px rgba(255, 31, 75, 0.55);
  }

  .evento {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
  }

  .evento h2 {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1rem, 2.4vw, 1.3rem);
    letter-spacing: 0.06em;
    color: #ff4d6d;
    margin: 0 0 1.25rem;
    text-align: center;
  }

  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
  }

  .galeria img,
  .holder {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    object-fit: cover;
  }

  .holder {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed rgba(255, 60, 90, 0.45);
    background:
      repeating-linear-gradient(135deg, rgba(255, 30, 70, 0.06) 0 12px, transparent 12px 24px),
      rgba(30, 6, 12, 0.55);
  }

  .holder span {
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 120, 140, 0.75);
  }
</style>
