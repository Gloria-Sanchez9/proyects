---
import BaseLayoutProtocol from '../../layouts/BaseLayoutProtocol.astro';

// Sección "Física real y ficción" (basada en el documento de MexIHC 2026)
const fisica = [
  { tema: 'Quarks Up y Down y nucleones', enJuego: 'En la Máquina Sintetizadora fusionas quarks para formar protones y neutrones.' },
  { tema: 'Nucleosíntesis estelar', enJuego: 'Inspira la fase de síntesis subatómica.' },
  { tema: 'Isótopos y superconductividad', enJuego: 'Obtienes isótopos y estabilizas la mezcla con un material superconductor.' },
  { tema: 'Campo de Higgs y primera ley de Newton', enJuego: 'Los Colosos ganan masa: se mueven más lento, pero con más energía cinética.' },
  { tema: 'Interacción débil y decaimiento radiactivo', enJuego: 'Los Segadores usan cesio inestable para acelerar el decaimiento de los enemigos.' },
  { tema: 'Dualidad onda-partícula y superposición cuántica', enJuego: 'Los Espectros esquivan en superposición y "colapsan" al atacar, con efectos de ionización.' },
  { tema: 'Radiación Hawking y simetría temporal', enJuego: 'Alterar el espacio-tiempo tiene un costo para el jugador.' },
  { tema: 'Termodinámica', enJuego: 'Usar la interacción débil eleva una temperatura crítica en el HUD.' },
];

const ficcion = [
  { tema: 'La Colmena Kaiju y su Reina', enJuego: 'La amenaza que recolecta biomasa; la Reina es un agujero negro temporal.' },
  { tema: 'Sangre Kaiju', enJuego: 'Funciona como material superconductor para producir el Líquido de Enlace.' },
  { tema: 'Líquido de Enlace', enJuego: 'La interfaz que permite al jugador modificar la física del entorno.' },
  { tema: 'Sarcófago Biomecánico', enJuego: 'Donde Axis cambia entre sus tres configuraciones de combate.' },
  { tema: 'ADN aislado topológicamente', enJuego: 'Lo que permite a Axis alternar entre Colosos, Segadores y Espectros.' },
  { tema: 'Demencia Cuántica', enJuego: 'Un costo inventado por manipular las leyes físicas.' },
  { tema: 'La Utopía Colectiva y el Cónclave de los Cuatro', enJuego: 'La sociedad estancada donde vive la humanidad.' },
];
---

<BaseLayoutProtocol title="Física y ficción | Protocol Entropy">

  <!-- Encabezado con el mismo estilo del inicio -->
  <section class="encabezado">
    <div class="glow glow-1" aria-hidden="true"></div>
    <div class="glow glow-2" aria-hidden="true"></div>

    <span class="etiqueta">Protocol Entropy</span>
    <h1 class="encabezado-titulo">Física real<br /><span>&gt;&lt;</span> ficción</h1>
    <p class="encabezado-texto">
      El juego mezcla a propósito conceptos reales de física con elementos de ciencia ficción.
      Aquí separamos qué es qué.
    </p>
  </section>

  <section class="temas" id="temas">
    <div class="glow glow-3" aria-hidden="true"></div>

    <div class="temas-grid">
      <div class="temas-col real">
        <h2><span class="temas-icono" aria-hidden="true">⚛</span> Física real</h2>
        <p class="temas-sub">Conceptos que inspiran las mecánicas</p>
        <ul>
          {fisica.map((t) => (
            <li>
              <strong>{t.tema}</strong>
              <span>{t.enJuego}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="temas-col ficcion">
        <h2><span class="temas-icono" aria-hidden="true">✦</span> Ficción</h2>
        <p class="temas-sub">Elementos inventados para la historia</p>
        <ul>
          {ficcion.map((t) => (
            <li>
              <strong>{t.tema}</strong>
              <span>{t.enJuego}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="temas-pie">
      Las mecánicas son representaciones simplificadas, no modelos físicos exactos. La meta no es
      dominar la física, sino familiarizarse con sus conceptos y su vocabulario.
    </p>
  </section>

</BaseLayoutProtocol>

<style>
  .encabezado, .temas {
    --rojo: #ff1f4b;
    --rojo-suave: #ff4d6d;
    --texto: #f2e9ea;
    --texto-2: #b9a9ac;
    --negro: #050304;
    position: relative;
    overflow: hidden;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
  }

  /* ---------- Encabezado ---------- */
  .encabezado {
    padding: 150px 6vw 70px;
    text-align: center;
    background: linear-gradient(180deg, #2a0309 0%, #140205 60%, #0d0205 100%);
  }

  .glow-1 { width: 520px; height: 420px; background: rgba(255, 0, 40, 0.35); top: -240px; right: -140px; }
  .glow-2 { width: 420px; height: 320px; background: rgba(180, 0, 30, 0.22); top: 20px; left: -200px; }
  .glow-3 { width: 640px; height: 320px; background: rgba(255, 0, 40, 0.12); top: 30%; left: 50%; transform: translateX(-50%); }

  .etiqueta {
    position: relative;
    display: inline-block;
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rojo-suave);
    border: 1px solid rgba(255, 77, 109, 0.5);
    border-radius: 999px;
    padding: 6px 14px;
    margin-bottom: 22px;
  }

  .encabezado-titulo {
    position: relative;
    font-family: 'Orbitron', sans-serif;
    font-weight: 900;
    font-size: clamp(2rem, 6vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 18px;
    color: var(--texto);
    text-shadow: 0 0 24px rgba(255, 31, 75, 0.7), 0 0 4px rgba(255, 120, 140, 0.8);
  }

  .encabezado-titulo span {
    color: var(--rojo);
  }

  .encabezado-texto {
    position: relative;
    font-family: 'Mulish', sans-serif;
    color: var(--texto-2);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.65;
    font-size: clamp(0.98rem, 1.6vw, 1.1rem);
  }

  /* ---------- 3.5 FÍSICA REAL Y FICCIÓN ---------- */
  .temas {
    background: #0d0205;
    padding: 30px 6vw 100px;
  }

  .temas-pie {
    font-family: 'Mulish', sans-serif;
    color: var(--texto-2);
    text-align: center;
    max-width: 640px;
    margin: -1.5rem auto 2.5rem;
    line-height: 1.6;
  }

  .temas-pie {
    margin: 2.5rem auto 0;
    font-size: 0.9rem;
    font-style: italic;
  }

  .temas-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 3vw, 32px);
    max-width: 1100px;
    margin: 0 auto;
  }

  .temas-col {
    border-radius: 16px;
    padding: 26px clamp(18px, 3vw, 28px);
  }

  .temas-col.real {
    border: 1px solid rgba(255, 77, 109, 0.45);
    background: linear-gradient(180deg, rgba(255, 31, 75, 0.12), rgba(255, 31, 75, 0.03));
  }

  /* la ficción va con borde punteado y tono morado, para que se distinga a simple vista */
  .temas-col.ficcion {
    border: 1px dashed rgba(190, 120, 255, 0.5);
    background: linear-gradient(180deg, rgba(150, 70, 255, 0.1), rgba(150, 70, 255, 0.02));
  }

  .temas-col h2 {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 4px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .real h2 { color: var(--rojo-suave); }
  .ficcion h2 { color: #c79bff; }

  .temas-icono { font-size: 1.3em; line-height: 1; }

  .temas-sub {
    font-family: 'Mulish', sans-serif;
    font-size: 0.85rem;
    color: var(--texto-2);
    margin: 0 0 18px;
  }

  .temas-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .temas-col li {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 12px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.3);
    font-family: 'Mulish', sans-serif;
    line-height: 1.5;
  }

  .temas-col li strong {
    color: var(--texto);
    font-size: 0.98rem;
  }

  .temas-col li span {
    color: var(--texto-2);
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .temas-grid { grid-template-columns: 1fr; }
  }

  .temas-grid,
  .temas-pie {
    position: relative;
  }
</style>
