---
// src/components/NavProtocol.astro
const currentPath = Astro.url.pathname;
const base = "/proyects/protocol-entropy";

const links = [
  { href: `${base}/inicioProtocol`, label: "INICIO" },
  { href: `${base}/inicioProtocol#sobre`, label: "SOBRE" },
  { href: `${base}/fisicaProtocol`, label: "FÍSICA Y FICCIÓN" },
  { href: `${base}/evidenciasProtocol`, label: "EVIDENCIAS" },
];
---

<nav class="pe-nav">
    <div class="pe-nav-logo">
        <a href="/proyects/" aria-label="Ir al inicio de ELOA">
            <img src="/proyects/imagenes/inicio/logo1FINAL.png" alt="ELOA">
        </a>
    </div>
    {links.map(link => (
      <a
        href={link.href}
        class:list={["pe-nav-link", { activo: currentPath === link.href }]}
      >
        {link.label}
      </a>
    ))}
</nav>

<style>
.pe-nav,
.pe-nav *{
    box-sizing: border-box;
}

.pe-nav{
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 22px;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10000;
    background-color: rgba(10, 6, 8, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255, 40, 70, 0.25);
    box-shadow: 0 2px 18px rgba(255, 0, 40, 0.12);
    padding: 10px 16px;
    min-height: 60px;
}

.pe-nav-logo{
    width: 46px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    order: -1;
    flex-basis: 100%;
}

.pe-nav-logo img{
    width: 90px;
    height: auto;
    /* el logo es oscuro: lo aclaramos para que se lea sobre el fondo negro */
    filter: brightness(0) invert(1);
    opacity: 0.92;
}

.pe-nav-link{
    text-decoration: none;
    color: #f2e9ea;
    font-size: 13px;
    font-family: 'Orbitron', 'Mulish', sans-serif;
    font-weight: 600;
    letter-spacing: 0.08em;
    white-space: nowrap;
    padding-bottom: 3px;
    border-bottom: 3px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
}

.pe-nav-link:hover,
.pe-nav-link.activo{
    color: #ff4d6d;
    border-bottom-color: #ff1f4b;
}

@media (min-width: 700px){
    .pe-nav{
        flex-wrap: nowrap;
        gap: 40px;
        min-height: 70px;
        padding: 0 30px;
    }

    .pe-nav-logo{
        width: 60px;
        height: 50px;
        order: 0;
        flex-basis: auto;
    }

    .pe-nav-logo img{
        width: 120px;
    }

    .pe-nav-link{
        font-size: 15px;
    }
}
</style>
